{"type":"app","meta":{"headers":{"x-next-cache-tags":"_N_T_/layout,_N_T_/jobs/layout,_N_T_/jobs/cgssb-food-drug-administration-recruitment-2026/layout,_N_T_/jobs/cgssb-food-drug-administration-recruitment-2026/page,_N_T_/jobs/cgssb-food-drug-administration-recruitment-2026"}},"html":"<!DOCTYPE html><html lang=\"hi\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\"/><link rel=\"preload\" as=\"image\" href=\"/images/cgssb-food-drug-administration.webp\"/><link rel=\"stylesheet\" href=\"/_next/static/css/a082d47af8c37992.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-fe1bb94b21fde89c.js\"/><script src=\"/_next/static/chunks/fd9d1056-123aadff3a6f1f43.js\" async=\"\"></script><script src=\"/_next/static/chunks/5030-dfb188e0fb5d9176.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-9edc01f96f8414ff.js\" async=\"\"></script><script src=\"/_next/static/chunks/5878-ab61975c236bb910.js\" async=\"\"></script><script src=\"/_next/static/chunks/2972-f2e7899c8cf0f9e3.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-4a8f5ea9fb7efe7b.js\" async=\"\"></script><title>CGSSB Food &amp; Drug Administration Recruitment 2026: Lab Assistant &amp; Sampling Assistant</title><meta name=\"description\" content=\"CGSSB Food &amp; Drug Administration Recruitment 2026 - Apply Online for 36 Posts of Lab Assistant and Sampling Assistant. Check eligibility, syllabus, and exam pattern.\"/><link rel=\"icon\" href=\"/icon.jpg\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body><header style=\"background-color:var(--bg-body);border-bottom:1px solid var(--border-color);position:sticky;top:0;z-index:100\"><div class=\"container\" style=\"display:flex;justify-content:space-between;align-items:center;height:70px\"><a style=\"display:flex;align-items:center;gap:10px;font-size:1.5rem;font-weight:700;color:var(--color-primary);letter-spacing:-0.5px\" href=\"/\"><img alt=\"CGSSB Logo\" loading=\"lazy\" width=\"36\" height=\"36\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent;border-radius:6px\" srcSet=\"/_next/image?url=%2Flogo.jpg&amp;w=48&amp;q=75 1x, /_next/image?url=%2Flogo.jpg&amp;w=96&amp;q=75 2x\" src=\"/_next/image?url=%2Flogo.jpg&amp;w=96&amp;q=75\"/>CGSSB</a><nav class=\"desktop-only\" style=\"gap:24px\"><a style=\"font-weight:500;color:var(--text-main)\" href=\"/jobs\">Jobs</a><a style=\"font-weight:500;color:var(--text-main)\" href=\"/current-affairs\">Current Affairs</a><a style=\"font-weight:500;color:var(--text-main)\" href=\"/cg-gk\">CG GK</a><a style=\"font-weight:500;color:var(--text-main)\" href=\"/tools\">Tools</a></nav><button class=\"mobile-only\" aria-label=\"Toggle menu\" style=\"background:none;border:none;flex-direction:column;justify-content:center;align-items:center;gap:5px;width:30px;height:30px;cursor:pointer\"><span style=\"display:block;width:25px;height:3px;background-color:var(--text-main);transition:all 0.3s;transform:none\"></span><span style=\"display:block;width:25px;height:3px;background-color:var(--text-main);opacity:1\"></span><span style=\"display:block;width:25px;height:3px;background-color:var(--text-main);transition:all 0.3s;transform:none\"></span></button></div></header><main style=\"min-height:calc(100vh - 70px - 150px)\"><div class=\"container premium-article-container\" style=\"padding-top:40px\"><div style=\"margin-bottom:25px;font-size:0.95rem;color:var(--text-muted)\"><a href=\"/\" class=\"hover-primary\">Home</a> » <a href=\"/jobs\" class=\"hover-primary\">Jobs</a> » <span style=\"color:var(--color-primary);font-weight:600\">Food &amp; Drug Administration Recruitment 2026</span></div><article class=\"premium-card\" style=\"padding:0;overflow:hidden\"><header style=\"padding:40px;border-bottom:1px solid var(--border-color);background:var(--card-bg);border-top-left-radius:16px;border-top-right-radius:16px\"><span style=\"background:var(--card-bg);color:var(--color-primary);border:1px solid var(--border-color);padding:6px 16px;border-radius:20px;font-size:0.85rem;font-weight:bold;display:inline-block;margin-bottom:15px\">खाद्य एवं औषधि प्रशासन, छत्तीसगढ़</span><h1 style=\"color:var(--text-main);font-size:2.4rem;font-weight:800;line-height:1.3;margin-bottom:15px\">CGSSB Food &amp; Drug Administration Recruitment 2026: लैब असिस्टेंट और नमूना सहायक के 36 पद, आवेदन, योग्यता, परीक्षा तिथि और सिलेबस</h1></header><section class=\"seo-content-section\" style=\"padding:40px\"><div style=\"display:flex;flex-wrap:wrap;align-items:center;gap:15px;margin-bottom:25px;padding:15px;background:#f8fafc;border-radius:10px;border:1px solid var(--border-color)\"><div style=\"width:45px;height:45px;border-radius:50%;background-color:var(--color-primary);display:flex;align-items:center;justify-content:center;color:white;font-size:1.2rem;font-weight:bold\">Y</div><div><p style=\"margin:0;font-size:0.95rem;color:var(--text-main);font-weight:600\">Written &amp; Reviewed by <a href=\"/author/yuvraj-pratap-rajwade\" style=\"color:var(--color-primary);text-decoration:none\" class=\"hover-underline\">Yuvraj Pratap Rajwade</a></p><p style=\"margin:0;font-size:0.85rem;color:var(--text-muted)\">Independent Web Developer and Publisher • Last Updated: <!-- -->16 August 2026</p></div></div><div style=\"position:relative;width:100%;height:auto;margin-bottom:30px;border-radius:12px;overflow:hidden;border:1px solid var(--border-color);box-shadow:0 4px 6px rgba(0,0,0,0.05)\"><img src=\"/images/cgssb-food-drug-administration.webp\" alt=\"CGSSB Food &amp; Drug Administration Recruitment 2026\" style=\"width:100%;height:auto;display:block\"/><div style=\"position:absolute;bottom:10px;right:10px;background:rgba(0,0,0,0.65);color:white;padding:5px 10px;border-radius:4px;font-size:0.8rem;z-index:10\">This image is AI generated</div></div><p class=\"content-paragraph\"><strong>CGSSB Food &amp; Drug Administration Recruitment 2026</strong> के तहत छत्तीसगढ़ के खाद्य एवं औषधि प्रशासन विभाग में <strong>Lab Assistant</strong> और <strong>Sampling Assistant</strong> के पदों पर भर्ती की जा रही है। इस भर्ती में कुल 36 पद शामिल हैं।</p><p class=\"content-paragraph\">जारी विज्ञापनों के अनुसार भर्ती में <strong>Lab Assistant (Food Testing Laboratory)</strong>, <strong>Lab Assistant (Drug Testing Laboratory)</strong> और <strong>Sampling Assistant (नमूना सहायक)</strong> के पद हैं। आवेदन छत्तीसगढ़ के स्थानीय निवासियों से ऑनलाइन माध्यम से आमंत्रित किए गए हैं।</p><p class=\"content-paragraph\">इस भर्ती के लिए CGSSB द्वारा जारी परीक्षा निर्देश में ऑनलाइन आवेदन की शुरुआत 7 जुलाई 2026 और अंतिम तिथि 31 जुलाई 2026 शाम 5 बजे तक बताई गई है। परीक्षा की संभावित तारीख 20 सितंबर 2026 है।</p><h2 class=\"article-section-title\">CGSSB Food &amp; Drug Administration Recruitment 2026 – Overview</h2><div class=\"premium-table-wrapper\"><table class=\"premium-table\"><tbody><tr><td><strong>विभाग</strong></td><td>खाद्य एवं औषधि प्रशासन, छत्तीसगढ़</td></tr><tr><td><strong>भर्ती परीक्षा</strong></td><td>FWLN26</td></tr><tr><td><strong>भर्ती पद</strong></td><td>Lab Assistant और Sampling Assistant</td></tr><tr><td><strong>कुल पद</strong></td><td>36</td></tr><tr><td><strong>आवेदन माध्यम</strong></td><td>Online</td></tr><tr><td><strong>आवेदन शुरू</strong></td><td>7 जुलाई 2026</td></tr><tr><td><strong>आवेदन की अंतिम तिथि</strong></td><td><strong style=\"color:#ef4444\">31 जुलाई 2026, शाम 5 बजे तक</strong></td></tr><tr><td><strong>Correction Window</strong></td><td>3 अगस्त 2026 से 5 अगस्त 2026, शाम 5 बजे तक</td></tr><tr><td><strong>परीक्षा की संभावित तिथि</strong></td><td><strong>20 सितंबर 2026</strong></td></tr><tr><td><strong>परीक्षा समय</strong></td><td>सुबह 10:00 से दोपहर 12:15 बजे तक</td></tr><tr><td><strong>संभावित Admit Card</strong></td><td>11 सितंबर 2026</td></tr><tr><td><strong>परीक्षा केंद्र</strong></td><td>5 संभागीय जिला मुख्यालय</td></tr><tr><td><strong>परीक्षा का प्रकार</strong></td><td>लिखित परीक्षा</td></tr></tbody></table></div><h2 class=\"article-section-title\">कितने पदों पर भर्ती होगी?</h2><p class=\"content-paragraph\">इस भर्ती में कुल <strong>36 रिक्त पद</strong> हैं। पदों का विवरण इस प्रकार है:</p><div class=\"premium-table-wrapper\"><table class=\"premium-table\"><thead><tr><th>क्र.</th><th>पद का नाम</th><th>पदों की संख्या</th><th>वेतनमान</th></tr></thead><tbody><tr><td>1</td><td>Lab Assistant (Food Testing Laboratory)</td><td>03</td><td>₹5,200–20,200 + ₹1,900 Grade Pay, Level 4</td></tr><tr><td>2</td><td>Lab Assistant (Drug Testing Laboratory)</td><td>03</td><td>₹5,200–20,200 + ₹1,900 Grade Pay, Level 4</td></tr><tr><td>3</td><td>Sampling Assistant (नमूना सहायक)</td><td>30</td><td>₹5,200–20,200 + ₹1,900 Grade Pay, Level 4</td></tr><tr><td colSpan=\"2\" style=\"text-align:right\"><strong>कुल</strong></td><td colSpan=\"2\"><strong>36</strong></td></tr></tbody></table></div><h2 class=\"article-section-title\">पद विवरण एवं शैक्षणिक योग्यता</h2><h3 style=\"font-size:1.4rem;margin-bottom:10px;color:var(--text-main);font-weight:600\">1. Lab Assistant – Food Testing Laboratory</h3><p class=\"content-paragraph\">Food Testing Laboratory में Lab Assistant के 3 पद हैं।</p><ul class=\"premium-list\"><li><strong>वेतनमान:</strong> ₹5,200–20,200 + ₹1,900 Grade Pay, Level 4</li><li><strong>शैक्षणिक योग्यता:</strong> उम्मीदवार को किसी मान्यता प्राप्त मंडल से विज्ञान संकाय (रसायन विज्ञान सहित) में Higher Secondary (10+2) परीक्षा उत्तीर्ण होना चाहिए।</li><li><strong>आयु सीमा:</strong> न्यूनतम आयु 18 वर्ष, अधिकतम आयु 30 वर्ष। (छत्तीसगढ़ के स्थानीय निवासियों के लिए शासन के नियमों के अनुसार आयु में छूट का प्रावधान है।)</li></ul><h3 style=\"font-size:1.4rem;margin-bottom:10px;color:var(--text-main);font-weight:600;margin-top:30px\">2. Lab Assistant – Drug Testing Laboratory</h3><p class=\"content-paragraph\">Drug Testing Laboratory में भी 3 पदों पर Lab Assistant की भर्ती होगी।</p><ul class=\"premium-list\"><li><strong>वेतनमान:</strong> ₹5,200–20,200 + ₹1,900 Grade Pay, Level 4</li><li><strong>शैक्षणिक योग्यता:</strong> विज्ञान संकाय में Chemistry सहित Higher Secondary (10+2) परीक्षा उत्तीर्ण होना आवश्यक है।</li><li><strong>आयु सीमा:</strong> 18 से 30 वर्ष। (age relaxation लागू होगी)</li></ul><h3 style=\"font-size:1.4rem;margin-bottom:10px;color:var(--text-main);font-weight:600;margin-top:30px\">3. Sampling Assistant – नमूना सहायक</h3><p class=\"content-paragraph\">इस भर्ती में सबसे ज्यादा vacancies Sampling Assistant पद के लिए हैं, कुल 30 पद।</p><ul class=\"premium-list\"><li><strong>वेतनमान:</strong> ₹5,200–20,200 + ₹1,900 Grade Pay, Level 4</li><li><strong>शैक्षणिक योग्यता:</strong> विज्ञान संकाय (रसायन विज्ञान सहित) में Higher Secondary (10+2) परीक्षा उत्तीर्ण होना चाहिए।</li><li><strong>आयु सीमा:</strong> न्यूनतम 18 वर्ष, अधिकतम 30 वर्ष। (स्थानीय निवासियों के लिए अधिकतम आयु सीमा में 5 वर्ष तक की छूट है।)</li></ul><div class=\"premium-alert\"><strong style=\"font-size:1.1rem;display:block;margin-bottom:5px\">📌 कौन आवेदन कर सकता है?</strong>इस भर्ती के लिए केवल <strong>छत्तीसगढ़ के स्थानीय निवासी</strong> उम्मीदवारों से आवेदन आमंत्रित किए गए हैं। दूसरे राज्यों के candidates को notification में दी गई eligibility conditions को ध्यान से देखना चाहिए।</div><div class=\"premium-alert\" style=\"background:var(--card-bg);border-color:var(--border-color);margin-top:20px\"><strong style=\"color:var(--color-primary);font-size:1.1rem;display:block;margin-bottom:5px\">📖 शैक्षणिक योग्यता के नए नियम (2026 अपडेट)</strong>क्या आपको पता है कि छत्तीसगढ़ सरकार ने हाल ही में तृतीय एवं चतुर्थ श्रेणी पदों के लिए न्यूनतम शैक्षणिक योग्यताओं (Group 1 से Group 7) में बड़े बदलाव किए हैं?<br/><br/><a href=\"/jobs/cgssb-recruitment-rules-2026\" style=\"color:var(--color-primary);font-weight:bold;text-decoration:underline\">CGSSB Recruitment Rules 2026: Group-1 से Group-7 तक की पूरी जानकारी यहाँ पढ़ें →</a></div><h2 class=\"article-section-title\">Application Form &amp; Important Documents</h2><p class=\"content-paragraph\">आवेदन online माध्यम से CGSSB पोर्टल पर profile registration के बाद भरा जाएगा।</p><p class=\"content-paragraph\"><strong>Documents:</strong> Online application के साथ caste, date of birth, domicile और educational certificates upload नहीं किए जा रहे हैं। इन documents का verification नियुक्तिकर्ता अधिकारी द्वारा किया जाएगा। Photograph और signature upload करने के लिए 50 KB से 100 KB की file size निर्धारित की गई है।</p><h3 style=\"font-size:1.4rem;margin-bottom:10px;color:var(--text-main);font-weight:600;margin-top:30px\">Exam Fee कितनी है?</h3><div class=\"premium-table-wrapper\"><table class=\"premium-table\" style=\"width:auto\"><thead><tr><th>Category</th><th>परीक्षा शुल्क</th></tr></thead><tbody><tr><td>General</td><td>₹350</td></tr><tr><td>OBC</td><td>₹250</td></tr><tr><td>SC/ST/PwD</td><td>₹200</td></tr></tbody></table></div><p class=\"content-paragraph\" style=\"margin-top:10px\"><em>छत्तीसगढ़ के स्थानीय निवासी candidate यदि परीक्षा में उपस्थित होते हैं, तो शासन के नियमों के अनुसार उनकी examination fee वापस (Refund) की जाएगी।</em></p><h2 class=\"article-section-title\">CGSSB FWLN26 Exam Pattern</h2><p class=\"content-paragraph\">इस भर्ती के लिए 100 marks का एक question paper होगा।</p><ul class=\"premium-list\"><li><strong>कुल प्रश्न:</strong> 100 (Objective Type)</li><li><strong>कुल अंक:</strong> 100</li><li><strong>परीक्षा अवधि:</strong> 2 घंटे</li><li><strong>Negative Marking:</strong> <span style=\"color:#ef4444;font-weight:bold\">हाँ (1/4 अंक की कटौती)</span></li></ul><h2 class=\"article-section-title\">FWLN26 Syllabus</h2><p class=\"content-paragraph\">Syllabus को दो भागों में बांटा गया है:</p><h3 style=\"font-size:1.2rem;margin-bottom:10px;color:var(--color-primary);font-weight:600\">भाग-1 (50 अंक)</h3><div class=\"premium-table-wrapper\"><table class=\"premium-table\"><thead><tr><th>विषय</th><th>प्रश्न</th><th>अंक</th></tr></thead><tbody><tr><td>सामान्य ज्ञान</td><td>10</td><td>10</td></tr><tr><td>छत्तीसगढ़ का सामान्य ज्ञान</td><td>10</td><td>10</td></tr><tr><td>योग्यता परीक्षण</td><td>10</td><td>10</td></tr><tr><td>कम्प्यूटर का सामान्य ज्ञान</td><td>5</td><td>5</td></tr><tr><td>हिन्दी भाषा का ज्ञान</td><td>5</td><td>5</td></tr><tr><td>छत्तीसगढ़ी भाषा का ज्ञान</td><td>5</td><td>5</td></tr><tr><td>अंग्रेजी भाषा का ज्ञान</td><td>5</td><td>5</td></tr></tbody></table></div><h3 style=\"font-size:1.2rem;margin-bottom:10px;color:var(--color-primary);font-weight:600;margin-top:20px\">भाग-2 (50 अंक - Science Subject)</h3><div class=\"premium-table-wrapper\"><table class=\"premium-table\"><thead><tr><th>विषय</th><th>प्रश्न</th><th>अंक</th></tr></thead><tbody><tr><td>रसायन विज्ञान (Chemistry)</td><td>30</td><td>30</td></tr><tr><td>भौतिक विज्ञान (Physics)</td><td>10</td><td>10</td></tr><tr><td>जीव विज्ञान (Biology)</td><td>10</td><td>10</td></tr></tbody></table></div><p class=\"content-paragraph\"><strong>तैयारी का टिप:</strong> Chemistry 30 अंकों की है, इसलिए Physical, Inorganic और Organic Chemistry को प्राथमिकता दें। गलत answer पर 1/4 mark कटेगा, इसलिए blind guessing से बचें।</p><h2 class=\"article-section-title\">Selection Process &amp; Probation</h2><p class=\"content-paragraph\">Selection लिखित परीक्षा की मेरिट के आधार पर होगा। चयनित candidates की नियुक्ति सीधे permanent status में नहीं होगी। विज्ञापन के अनुसार direct recruitment से selected candidates को 3 वर्ष की probation period (परिवीक्षा अवधि) पर नियुक्त किया जाएगा। नियुक्ति से पहले medical fitness certificate देना होगा और पुलिस verification भी किया जाएगा।</p><h2 class=\"article-section-title\">Important Links</h2><div style=\"display:flex;gap:15px;flex-wrap:wrap;margin-bottom:30px\"><a href=\"https://vyapamcg.cgstate.gov.in/?utm_source=cgssb.com.in\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"background:var(--color-primary);color:white;padding:12px 24px;border-radius:8px;font-weight:bold;display:inline-block;box-shadow:0 4px 6px rgba(37,99,235,0.2)\">🌐 CG Vyapam Official Website</a></div><div class=\"premium-alert\" style=\"background:var(--card-bg-hover);border-color:var(--border-color)\"><strong style=\"color:#ef4444\">जरूरी सूचना:</strong>यह article खाद्य एवं औषधि प्रशासन, छत्तीसगढ़ के विस्तृत विज्ञापनों और CGSSB के FWLN26 परीक्षा निर्देशों के आधार पर तैयार किया गया है। परीक्षा की तारीख 20 सितंबर 2026 &quot;संभावित तिथि&quot; है। कृपया नवीनतम अपडेट के लिए आधिकारिक वेबसाइट विजिट करें।</div><div style=\"margin-top:40px;padding:25px;background:#f8fafc;border-radius:12px;border:1px solid var(--border-color)\"><h3 style=\"font-size:1.2rem;margin-bottom:15px;color:var(--text-main)\">📋 Article Information</h3><ul style=\"list-style:none;padding:0;margin:0;font-size:0.95rem;color:var(--text-muted);display:flex;flex-direction:column;gap:10px\"><li><strong>Written &amp; Reviewed by:</strong> <a href=\"/author/yuvraj-pratap-rajwade\" style=\"color:var(--color-primary);text-decoration:none\">Yuvraj Pratap Rajwade</a></li><li><strong>Last Updated:</strong> <!-- -->16 August 2026</li><li><strong>Source:</strong> <a href=\"https://vyapamcg.cgstate.gov.in/\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:var(--color-primary);text-decoration:none\">Official CGSSB (FWLN26) &amp; Food and Drug Administration Notification</a></li><li><strong>Correction:</strong> जानकारी में कोई गलती मिले? <a href=\"mailto:contact@cgssb.com.in\" style=\"color:#d97706;text-decoration:none;font-weight:600\">[Report a Correction]</a></li></ul></div></section></article></div></main><footer style=\"background-color:var(--bg-card);border-top:1px solid var(--border-color);padding:40px 0 20px;margin-top:60px\"><div class=\"container\" style=\"display:flex;flex-direction:column;align-items:center;text-align:center\"><h3 style=\"margin-bottom:10px\">Chhattisgarh Career &amp; Education Portal</h3><p style=\"max-width:600px;font-size:0.9rem\">One-stop destination for CGSSB, CGPSC, Vyapam notifications, syllabus, results, and study materials.</p><div style=\"max-width:800px;background-color:#fffbe8;border:1px solid #fde68a;padding:12px 16px;border-radius:6px;margin-top:20px;font-size:0.85rem;color:#92400e;text-align:left\"><strong>Disclaimer:</strong> CGSSB is an independent informational website and is not affiliated with or operated by the Government of Chhattisgarh, CGSSB, CG Vyapam, CGPSC, or any other government department or examination authority. For official information, please verify details from the relevant official website or notification.</div><div style=\"display:flex;flex-wrap:wrap;justify-content:center;gap:15px;margin-top:25px;padding-bottom:25px;border-bottom:1px solid var(--border-color);width:100%;max-width:800px\"><a style=\"font-size:0.85rem;color:var(--text-main)\" href=\"/about-us\">About Us</a><span style=\"color:var(--border-color)\">|</span><a style=\"font-size:0.85rem;color:var(--text-main)\" href=\"/author/yuvraj-pratap-rajwade\">Author</a><span style=\"color:var(--border-color)\">|</span><a style=\"font-size:0.85rem;color:var(--text-main)\" href=\"/editorial-policy\">Editorial Policy</a><span style=\"color:var(--border-color)\">|</span><a style=\"font-size:0.85rem;color:var(--text-main)\" href=\"/correction-policy\">Correction Policy</a><span style=\"color:var(--border-color)\">|</span><a style=\"font-size:0.85rem;color:var(--text-main)\" href=\"/contact-us\">Contact Us</a><span style=\"color:var(--border-color)\">|</span><a style=\"font-size:0.85rem;color:var(--text-main)\" href=\"/privacy-policy\">Privacy Policy</a><span style=\"color:var(--border-color)\">|</span><a style=\"font-size:0.85rem;color:var(--text-main)\" href=\"/terms\">Terms &amp; Conditions</a><span style=\"color:var(--border-color)\">|</span><a style=\"font-size:0.85rem;color:var(--text-main)\" href=\"/disclaimer\">Disclaimer</a></div><div style=\"margin-top:20px;font-size:0.85rem;color:var(--text-muted)\">© <!-- -->2026<!-- --> CGSSB Portal. Built for the students of Chhattisgarh. <br/>Email us at: <a href=\"mailto:contact@cgssb.com.in\" style=\"color:var(--color-primary)\">contact@cgssb.com.in</a></