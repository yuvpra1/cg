\",\\\"borderRadius\\\":\\\"10px\\\",\\\"border\\\":\\\"1px solid var(--border-color)\\\"},\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"width\\\":\\\"45px\\\",\\\"height\\\":\\\"45px\\\",\\\"borderRadius\\\":\\\"50%\\\",\\\"backgroundColor\\\":\\\"var(--color-primary)\\\",\\\"display\\\":\\\"flex\\\",\\\"alignItems\\\":\\\"center\\\",\\\"justifyContent\\\":\\\"center\\\",\\\"color\\\":\\\"white\\\",\\\"fontSize\\\":\\\"1.2rem\\\",\\\"fontWeight\\\":\\\"bold\\\"},\\\"children\\\":\\\"Y\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"style\\\":{\\\"margin\\\":0,\\\"fontSize\\\":\\\"0.95rem\\\",\\\"color\\\":\\\"var(--text-main)\\\",\\\"fontWeight\\\":\\\"600\\\"},\\\"children\\\":[\\\"Written \\u0026 Reviewed by \\\",[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"/author/yuvraj-pratap-rajwade\\\",\\\"style\\\":{\\\"color\\\":\\\"var(--color-primary)\\\",\\\"textDecoration\\\":\\\"none\\\"},\\\"className\\\":\\\"hover-underline\\\",\\\"children\\\":\\\"Yuvraj Pratap Rajwade\\\"}]]}],[\\\"$\\\",\\\"p\\\",null,{\\\"style\\\":{\\\"margin\\\":0,\\\"fontSize\\\":\\\"0.85rem\\\",\\\"color\\\":\\\"var(--text-muted)\\\"},\\\"children\\\":[\\\"Independent Web Developer and Publisher • Last Updated: \\\",\\\"16 August 2026\\\"]}]]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"position\\\":\\\"relative\\\",\\\"width\\\":\\\"100%\\\",\\\"height\\\":\\\"auto\\\",\\\"marginBottom\\\":\\\"30px\\\",\\\"borderRadius\\\":\\\"12px\\\",\\\"overflow\\\":\\\"hidden\\\",\\\"border\\\":\\\"1px solid var(--border-color)\\\",\\\"boxShadow\\\":\\\"0 4px 6px rgba(0,0,0,0.05)\\\"},\\\"children\\\":[[\\\"$\\\",\\\"img\\\",null,{\\\"src\\\":\\\"/images/cgssb-food-drug-administration.webp\\\",\\\"alt\\\":\\\"CGSSB Food \\u0026 Drug Administration Recruitment 2026\\\",\\\"style\\\":{\\\"width\\\":\\\"100%\\\",\\\"height\\\":\\\"auto\\\",\\\"display\\\":\\\"block\\\"}}],[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"position\\\":\\\"absolute