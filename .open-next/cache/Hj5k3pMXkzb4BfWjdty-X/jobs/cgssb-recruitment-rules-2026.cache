derTopRightRadius\\\":\\\"16px\\\"},\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"style\\\":{\\\"background\\\":\\\"var(--card-bg)\\\",\\\"color\\\":\\\"var(--color-primary)\\\",\\\"border\\\":\\\"1px solid var(--border-color)\\\",\\\"padding\\\":\\\"6px 16px\\\",\\\"borderRadius\\\":\\\"20px\\\",\\\"fontSize\\\":\\\"0.85rem\\\",\\\"fontWeight\\\":\\\"bold\\\",\\\"display\\\":\\\"inline-block\\\",\\\"marginBottom\\\":\\\"15px\\\"},\\\"children\\\":\\\"सामान्य प्रशासन विभाग, छत्तीसगढ़ शासन\\\"}],[\\\"$\\\",\\\"h1\\\",null,{\\\"style\\\":{\\\"color\\\":\\\"var(--text-main)\\\",\\\"fontSize\\\":\\\"2.4rem\\\",\\\"fontWeight\\\":\\\"800\\\",\\\"lineHeight\\\":\\\"1.3\\\",\\\"marginBottom\\\":\\\"15px\\\"},\\\"children\\\":\\\"CGSSB Recruitment Rules 2026: छत्तीसगढ़ में सरकारी भर्ती के लिए नई शैक्षणिक योग्यता, जानें Group-1 से Group-7 तक पूरी जानकारी\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"style\\\":{\\\"color\\\":\\\"var(--text-muted)\\\",\\\"fontSize\\\":\\\"0.95rem\\\",\\\"margin\\\":0,\\\"fontWeight\\\":\\\"500\\\"},\\\"children\\\":\\\"🕒 Last Updated: 16 August 2026\\\"}]]}],[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"seo-content-section\\\",\\\"style\\\":{\\\"padding\\\":\\\"40px\\\"},\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"display\\\":\\\"flex\\\",\\\"flexWrap\\\":\\\"wrap\\\",\\\"alignItems\\\":\\\"center\\\",\\\"gap\\\":\\\"15px\\\",\\\"marginBottom\\\":\\\"25px\\\",\\\"padding\\\":\\\"15px\\\",\\\"background\\\":\\\"#f8fafc\\\",\\\"borderRadius\\\":\\\"10px\\\",\\\"border\\\":\\\"1px solid var(--border-color)\\\"},\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"width\\\":\\\"45px\\\",\\\"height\\\":\\\"45px\\\",\\\"borderRadius\\\":\\\"50%\\\",\\\"backgroundColor\\\":\\\"var(--color-primary)\\\",\\\"display\\\":\\\"flex\\\",\\\"alignItems\\\":\\\"center\\\",\\\"justifyContent\\\":\\\"center\\\",\\\"color\\\":\\\"white\\\",\\\"fontSize\\\":\\\"1.2rem\\\",\\\"fontWeight\\\":\\\"bold\\\"},\\\"children\\\":\\\"Y\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"style\\\":{\\\"margin\\\":0,\\\"fontSize\\\":\\\"0.95rem\\\",\\\"color\\\":\\\"var(--text-main)\\\",\\\"fontWeight\\\":\\\"600\\\"},\\\"children\\\":[\\\"Written \\u0026 Reviewed by \\\",[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"/author/yuvraj-pratap-rajwade\\\",\\\"style\\\":{\\\"color\\\":\\\"var(--color-primary)\\\",\\\"textDecoration\\\":\\\"none\\\"},\\\"className\\\":\\\"hover-underline\\\",\\\"children\\\":\\\"Yuvraj Pratap Rajwade\\\"}]]}],[\\\"$\\\",\\\"p\\\",null,{\\\"style\\\":{\\\"margin\\\":0,\\\"fontSize\\\":\\\"0.85rem\\\",\\\"color\\\":\\\"var(--text-muted)\\\"},\\\"children\\\":[\\\"Independent Web Developer and Publisher • Last Updated: \\\",\\\"16 August 2026\\\"]}]]}]]}],[\\\"$\\\",\\\"img\\\",null,{\\\"src\\\":\\\"/images/cgssb-recruitment-rules-2026.webp\\\",\\\"alt\\\":\\\"CGSSB Recruitment Rules 2026 Group 1-7\\\",\\\"style\\\":{\\\"width\\\":\\\"100%\\\",\\\"height\\\":\\\"auto\\\",\\\"borderRadius\\\":\\\"12px\\\",\\\"marginBottom\\\":\\\"30px\\\",\\\"border\\\":\\\"1px solid var(--border-color)\\\",\\\"boxShadow\\\":\\\"0 4px 6px rgba(0,0,0,0.05)\\\"}}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"content-paragraph\\\",\\\"children\\\":[\\\"छत्तीसगढ़ में सरकारी नौकरी की तैयारी कर रहे छात्रों के लिए एक जरूरी अपडेट सामने आया है। छत्तीसगढ़ शासन के सामान्य प्रशासन विभाग ने विभिन्न \\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"तृतीय और चतुर्थ श्रेणी के पदों पर सीधी भर्ती के लिए न्यूनतम शैक्षणिक योग्यता\\\"}],\\\" निर्धारित की है।\\\"]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"content-paragraph\\\",\\\"children\\\":\\\"यह जानकारी इसलिए महत्वपूर्ण है क्योंकि किसी भी सरकारी भर्ती का फॉर्म भरने से पहले उम्मीदवार को यह पता होना चाहिए कि उसके पास उस पद के लिए जरूरी पढ़ाई और दूसरी योग्यताएं हैं या नहीं।\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"content-paragraph\\\",\\\"children\\\":[\\\"19 जून 2026 को जारी अधिसूचना में अलग-अलग पदों को उनकी शैक्षणिक योग्यता के आधार पर कई समूहों में रखा गया है। बाद में \\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"27 जुलाई 2026 को इसी अधिसूचना में कुछ महत्वपूर्ण संशोधन भी किए गए।\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"premium-alert\\\",\\\"style\\\":{\\\"background\\\":\\\"var(--card-bg-hover)\\\",\\\"borderColor\\\":\\\"var(--border-color)\\\"},\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"style\\\":{\\\"color\\\":\\\"var(--color-primary)\\\",\\\"fontSize\\\":\\\"1.1rem\\\",\\\"display\\\":\\\"block\\\",\\\"marginBottom\\\":\\\"5px\\\"},\\\"children\\\":\\\"⚠️ ध्यान दें:\\\"}],\\\"यह अधिसूचना अपने आप में किसी एक भर्ती की vacancy notification नहीं है। यह अलग-अलग सरकारी पदों के लिए निर्धारित \\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"न्यूनतम शैक्षणिक योग्यता और भर्ती परीक्षा की व्यवस्था\\\"}],\\\" को समझने वाला नियम है।\\\"]}],[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"article-section-title\\\",\\\"children\\\":\\\"सबसे पहले समझें—ये Group-1, Group-2 क्या हैं?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"content-paragraph\\\",\\\"children\\\":[\\\"अगर आपने notification में Group-1, Group-2, Group-3 आदि देखा है तो घबराने की जरूरत नहीं है। सरकार ने इन समूहों में पदों को मुख्य रूप से \\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"शैक्षणिक योग्यता के आधार पर\\\"}],\\\" रखा है। इसका मतलब यह नहीं है कि Group-1 हमेशा सबसे ज्यादा salary वाला पद है। अधिसूचना में साफ कहा गया है कि पदों का यह वर्गीकरण केवल शैक्षणिक योग्यता के आधार पर है और इसका वेतनमान से संबंध नहीं है।\\\"]}],[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"article-section-title\\\",\\\"children\\\":\\\"Group-1: Engineering से जुड़े पद\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"content-paragraph\\\",\\\"children\\\":[\\\"Group-1 में तृतीय श्रेणी की \\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"अभियांत्रिकी सेवा\\\"}],\\\" के पद रखे गए हैं। इसमें Civil, Electrical, Mechanical, Electronics, Computer Science/IT और Mining जैसे Engineering से जुड़े पद शामिल हैं।\\\"]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"content-paragraph\\\",\\\"children\\\":\\\"उदाहरण के लिए उप अभियंता (Mechanical) के लिए मान्यता प्राप्त संस्थान से Mechanical Engineering में तीन वर्षीय Diploma या B.E./B.Tech की योग्यता दी गई है। इसी तरह Computer Science/IT से जुड़े उप अभियंता पद के लिए संबंधित Diploma, B.E./B.Tech तथा कुछ उच्च योग्यताओं का उल्लेख है। यानी अगर कोई छात्र Engineering कर रहा है, तो उसके लिए यह हिस्सा काफी महत्वपूर्ण है।\\\"}],[\\\"$\\\",\\\"h3\\\",null,{\\\"style\\\":{\\\"fontSize\\\":\\\"1.3rem\\\",\\\"marginBottom\\\":\\\"10px\\\",\\\"color\\\":\\\"var(--text-main)\\\",\\\"fontWeight\\\":\\\"600\\\"},\\\"children\\\":\\\"27 जुलाई को Engineering में क्या बदला?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"content-paragraph\\\",\\\"children\\\":[\\\"27 जुलाई 2026 के संशोधन में \\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"उप अभियंता (विद्युत/यांत्रिकी)\\\"}],\\\" नाम से नया पद जोड़ा गया। इसके लिए Electrical या Mechanical Engineering में तीन वर्षीय Diploma अथवा B.E./B.Tech की योग्यता निर्धारित की गई है। इस पद के लिए भी भाग-अ अनिवार्य सामान्य और भाग-ब संकायवार पाठ्यक्रम की परीक्षा व्यवस्था रखी गई है।\\\"]}],[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"article-section-title\\\",\\\"children\\\":\\\"Group-2: Graduate और Postgraduate छात्रों के लिए महत्वपूर्ण\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"content-paragraph\\\",\\\"children\\\":[\\\"Group-2 में स्नातक और स्नातकोत्तर स्तर से जुड़े कई पद रखे गए हैं। इसमें \\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"सहायक प्रबंधक (उद्योग), सहायक श्रम पदाधिकारी, श्रम निरीक्षक, श्रम उप निरीक्षक, सहायक विकास विस्तार अधिकारी, सहकारिता निरीक्षक, खाद्य निरीक्षक, मंडी निरीक्षक, खेल अधिकारी, सूचना सहायक, वार्डन और स्टोर कीपर\\\"}],\\\" जैसे पद शामिल हैं।\\\"]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"content-paragraph\\\",\\\"children\\\":[\\\"इनमें कई पदों के लिए संबंधित विभागीय भर्ती नियम के अनुसार विषय में \\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"स्नातक\\\"}],\\\" होना जरूरी बताया गया है। इसलिए अगर आपने Graduation पूरी कर ली है, तो आपको सिर्फ किसी एक vacancy का इंतजार करने के बजाय इन पदों की eligibility को समझकर अपनी तैयारी शुरू करनी चाहिए।\\\"]}],[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"article-section-title\\\",\\\"children\\\":\\\"Stenographer, Data Entry और Computer Operator के लिए क्या योग्यता है?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"content-paragraph\\\",\\\"children\\\":[\\\"इस notification में computer और typing से जुड़े पदों के लिए केवल पढ़ाई ही नहीं, बल्कि \\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"skill qualification\\\"}],\\\" को भी महत्व दिया गया है।\\\"]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"content-paragraph\\\",\\\"children\\\":\\\"उदाहरण के लिए Stenographer से जुड़े पदों में Graduation अथवा कुछ परिस्थितियों में 10+2 के साथ Modern Office Management (MOM) Diploma जैसी योग्यता का उल्लेख है। कुछ पदों के लिए Hindi या English shorthand की निर्धारित speed और computer typing/key depression से जुड़े प्रमाण-पत्र भी जरूरी हैं।\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"content-paragraph\\\",\\\"children\\\":[\\\"यानी अगर आपका लक्ष्य Steno, DEO, Computer Operator या इसी तरह की नौकरी है, तो केवल certificate होना ही काफी नहीं हो सकता—\\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"typing और shorthand skill पर भी ध्यान देना जरूरी है।\\\"}]]}],[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"article-section-title\\\",\\\"children\\\":\\\"Group-3: शिक्षक और शिक्षा विभाग से जुड़े पद\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"content-paragraph\\\",\\\"children\\\":[\\\"यह हिस्सा students और teaching career की तैयारी करने वालों के लिए खास तौर पर महत्वपूर्ण है। Group-3 में \\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"शैक्षिक सेवा\\\"}],\\\" के पद रखे गए हैं।\\\"]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"content-paragraph\\\",\\\"children\\\":\\\"सहायक शिक्षक के लिए मान्यता प्राप्त मंडल से उच्चतर माध्यमिक यानी 10+2 या समकक्ष योग्यता तथा विभागीय भर्ती नियमों में निर्धारित अन्य योग्यताओं का उल्लेख है। वहीं शिक्षक पद के लिए संबंधित विषय में Graduation और अन्य आवश्यक qualifications तथा व्याख्याता के लिए संबंधित विषय में Post Graduation और अन्य योग्यताओं का उल्लेख है।\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"content-paragraph\\\",\\\"children\\\":[\\\"इसका सीधा मतलब है कि शिक्षक बनने की तैयारी कर रहे छात्रों को सिर्फ सामान्य graduation देखकर eligibility तय नहीं करनी चाहिए। \\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"अपने विषय और उस पद के विभागीय भर्ती नियम भी देखना जरूरी है।\\\"}]]}],[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"article-section-title\\\",\\\"children\\\":\\\"Group-4: Uniformed Services\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"content-paragraph\\\",\\\"children\\\":\\\"Group-4 में पुलिस और दूसरी uniformed services से जुड़े पद शामिल हैं।\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"content-paragraph\\\",\\\"children\\\":[\\\"उप निरीक्षक, सूबेदार और प्लाटून कमांडर जैसे पदों के लिए Graduation के साथ विभागीय भर्ती नियमों के अनुसार \\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"शारीरिक योग्यताएं\\\"}],\\\" भी जरूरी हैं। वहीं आरक्षक, परिवहन आरक्षक, आबकारी आरक्षक, जेल प्रहरी, वनरक्षक, नगर सैनिक और अन्य समकक्ष पदों के लिए 10+2 तथा संबंधित शारीरिक योग्यताओं का उल्लेख है।\\\"]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"content-paragraph\\\",\\\"children\\\":\\\"इसलिए इन jobs के उम्मीदवारों को पढ़ाई के साथ physical preparation पर भी ध्यान देना चाहिए।\\\"}],[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"article-section-title\\\",\\\"children\\\":\\\"Group-5: Science और Health Services\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"content-paragraph\\\",\\\"children\\\":\\\"Group-5 में विज्ञान और स्वास्थ्य सेवाओं से जुड़े पद शामिल हैं।\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"content-paragraph\\\",\\\"children\\\":\\\"उदाहरण के लिए Staff Nurse के लिए Nursing से संबंधित qualification और Nursing Council में registration की आवश्यकता बताई गई है। वहीं ग्रामीण स्वास्थ्य संयोजक के लिए 10+2 तथा अन्य विभागीय qualifications का उल्लेख है। Laboratory Assistant जैसे पदों के लिए Science stream में 10+2 की qualification दी गई है, जबकि Pharmacist के लिए Pharmacy में Diploma और संबंधित Pharmacy Council registration जैसी आवश्यकताएं बताई गई हैं।\\\"}],[\\\"$\\\",\\\"h3\\\",null,{\\\"style\\\":{\\\"fontSize\\\":\\\"1.3rem\\\",\\\"marginBottom\\\":\\\"10px\\\",\\\"color\\\":\\\"var(--text-main)\\\",\\\"fontWeight\\\":\\\"600\\\"},\\\"children\\\":\\\"27 जुलाई का एक और महत्वपूर्ण बदलाव\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"content-paragraph\\\",\\\"children\\\":[\\\"27 जुलाई 2026 के संशोधन में \\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"सहायक पशु चिकित्सा क्षेत्र अधिकारी\\\"}],\\\" को Group-2 से हटाकर Group-5 में जोड़ा गया। इस पद के लिए Biology विषय के साथ 10+2 तथा विभागीय भर्ती नियम में निर्धारित अन्य योग्यताओं का उल्लेख किया गया है।\\\"]}],[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"article-section-title\\\",\\\"children\\\":\\\"Group-6: 12वीं पास छात्रों के लिए भी मौके\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"content-paragraph\\\",\\\"children\\\":[\\\"Group-6 में कई ऐसे पद हैं जिनके लिए Higher Secondary यानी \\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"10+2\\\"}],\\\" स्तर की qualification महत्वपूर्ण है।\\\"]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"content-paragraph\\\",\\\"children\\\":\\\"इसमें सहायक मानचित्रकार, अनुरेखक, हैंडपंप टेक्नीशियन, इलेक्ट्रीशियन, फिटर, वेल्डर, टर्नर, मैकेनिक जैसे विभिन्न technical पद शामिल हैं। पटवारी और अमीन जैसे पदों के लिए भी 10+2 qualification का उल्लेख है। पटवारी के मामले में एक वर्षीय Computer Diploma भी निर्धारित है।\\\"}],[\\\"$\\\",\\\"h3\\\",null,{\\\"style\\\":{\\\"fontSize\\\":\\\"1.3rem\\\",\\\"marginBottom\\\":\\\"10px\\\",\\\"color\\\":\\\"var(--text-main)\\\",\\\"fontWeight\\\":\\\"600\\\"},\\\"children\\\":\\\"अनुरेखक के लिए नई qualification\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"content-paragraph\\\",\\\"children\\\":\\\"27 जुलाई 2026 के amendment में अनुरेखक की qualification को भी संशोधित किया गया। इसमें Drawing को एक विषय के रूप में लेकर 10+2 या समकक्ष परीक्षा, Higher Secondary Technical परीक्षा, Surveyor का vocational apprenticeship certificate या ITI से Draftsmanship certificate जैसे विकल्प दिए गए हैं।\\\"}],[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"article-section-title\\\",\\\"children\\\":\\\"Group-7: 10वीं पास छात्रों के लिए भी अवसर\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"content-paragraph\\\",\\\"children\\\":\\\"अगर आपने अभी केवल 10वीं पास की है तो भी सरकारी नौकरी के रास्ते बंद नहीं होते। Group-7 में वाहन चालक और चतुर्थ श्रेणी के कई पद शामिल हैं।\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"content-paragraph\\\",\\\"children\\\":\\\"वाहन चालक के लिए 10वीं पास होने के साथ valid driving licence और अन्य निर्धारित शर्तें हैं। वहीं नृत्य, चौकीदार, तुलावटी, चैनमैन, प्रोसेस सर्वर, स्वीपर, माली, केयरटेकर, हमाल, वार्ड बॉय, रसोइया, हेल्पर आदि जैसे पदों के लिए 10वीं पास qualification का उल्लेख है।\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"content-paragraph\\\",\\\"children\\\":\\\"इसलिए 10वीं पास छात्रों को भी सरकारी भर्ती की तैयारी करते समय इन पदों पर नजर रखनी चाहिए।\\\"}],[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"article-section-title\\\",\\\"children\\\":\\\"दिव्यांग उम्मीदवारों के लिए भी महत्वपूर्ण जानकारी\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"content-paragraph\\\",\\\"children\\\":\\\"तीसरी अधिसूचना दिव्यांगजन के लिए चिन्हांकित पदों से संबंधित है। 25 फरवरी 2026 की अधिसूचना में विभिन्न सरकारी विभागों में प्रथम, द्वितीय, तृतीय और चतुर्थ श्रेणी के पदों में दिव्यांगजन के लिए उपयुक्त पदों के चिन्हांकन की प्रक्रिया और सूची से संबंधित व्यवस्था दी गई है।\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"content-paragraph\\\",\\\"children\\\":\\\"इसमें यह भी बताया गया है कि यदि किसी दिव्यांगजन के लिए कोई feeder cadre पद चिन्हांकित है, तो उससे पदोन्नत होने वाला पद भी उसी आधार पर चिन्हांकित माना जाएगा। नियुक्ति के समय दिव्यांगता प्रमाण-पत्र की पुष्टि और आवश्यक शारीरिक दक्षता जांच की व्यवस्था भी बताई गई है।\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"content-paragraph\\\",\\\"children\\\":[\\\"इसलिए दिव्यांग उम्मीदवारों को किसी भर्ती का form भरते समय सिर्फ सामान्य eligibility ही नहीं, बल्कि \\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"अपने लिए चिन्हांकित पद और संबंधित reservation provisions\\\"}],\\\" भी देखना चाहिए।\\\"]}],[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"article-section-title\\\",\\\"children\\\":\\\"क्या इन नियमों के बाद सीधे भर्ती शुरू हो जाएगी?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"content-paragraph\\\",\\\"children\\\":[\\\"जरूरी नहीं। अधिसूचना में बताया गया है कि जब संबंधित प्रशासनिक विभागों से मांग-पत्र प्राप्त होगा, तब छत्तीसगढ़ कर्मचारी चयन मंडल अधिसूचित पदों और अन्य समकक्ष पदों की पूर्ति के लिए \\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Common Examination या पद/संकाय विशेष परीक्षा\\\"}],\\\" आयोजित कर सकता है।\\\"]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"content-paragraph\\\",\\\"children\\\":[\\\"इसके अलावा केवल minimum educational qualification पूरी होना ही नियुक्ति की गारंटी नहीं है। संबंधित पद के भर्ती नियमों में बताए गए \\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"अनुभव, प्रशिक्षण, skill/practical test और अन्य qualifications\\\"}],\\\" भी जरूरी हो सकती हैं।\\\"]}],[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"article-section-title\\\",\\\"children\\\":\\\"छात्रों को अब क्या करना चाहिए?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"content-paragraph\\\",\\\"children\\\":\\\"इस पूरी notification को देखकर सबसे जरूरी बात यह है कि आप अपनी qualification के हिसाब से रास्ता चुनें।\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"premium-list\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"10वीं पास हैं?\\\"}],\\\" Group-7 और संबंधित technical/other opportunities देखें।\\\"]}],[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"12वीं पास हैं?\\\"}],\\\" Group-6 के साथ अपने subject और technical qualification वाले पद देखें।\\\"]}],[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Graduation कर चुके हैं?\\\"}],\\\" Group-2, शिक्षक और अन्य graduate-level posts पर ध्यान दें।\\\"]}],[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Post Graduation या professional degree है?\\\"}],\\\" संबंधित subject-specific पदों के recruitment rules जरूर देखें।\\\"]}]]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"content-paragraph\\\",\\\"children\\\":\\\"और अगर आप Engineering, Nursing, Pharmacy, Computer, ITI, Typing या किसी दूसरे technical field से हैं, तो अपनी qualification के अनुरूप specific post की eligibility जरूर check करें।\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"premium-alert\\\",\\\"style\\\":{\\\"background\\\":\\\"var(--card-bg)\\\",\\\"borderColor\\\":\\\"var(--border-color)\\\"},\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"style\\\":{\\\"color\\\":\\\"var(--color-primary)\\\",\\\"fontSize\\\":\\\"1.1rem\\\",\\\"display\\\":\\\"block\\\",\\\"marginBottom\\\":\\\"5px\\\"},\\\"children\\\":\\\"📌 सबसे जरूरी बात\\\"}],[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"19 जून 2026 की मूल अधिसूचना को अकेले पढ़कर eligibility तय न करें।\\\"}],\\\" 27 जुलाई 2026 का संशोधन भी साथ में देखें, क्योंकि इसमें कुछ पदों की स्थिति और qualification में बदलाव किया गया है। यह नियम छात्रों को यह समझने में मदद करते हैं कि आने वाली अलग-अलग सरकारी भर्तियों में उनकी पढ़ाई के आधार पर कौन-से अवसर हो सकते हैं। लेकिन जब किसी particular post की vacancy जारी हो, तब \\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"उस भर्ती का official advertisement और संबंधित विभागीय भर्ती नियम ही अंतिम आधार\\\"}],\\\" होना चाहिए।\\\"]}],[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"article-section-title\\\",\\\"children\\\":\\\"Frequently Asked Questions (FAQs)\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"faq-section\\\",\\\"style\\\":{\\\"display\\\":\\\"flex\\\",\\\"flexDirection\\\":\\\"column\\\",\\\"gap\\\":\\\"15px\\\",\\\"marginBottom\\\":\\\"40px\\\"},\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"background\\\":\\\"var(--card-bg)\\\",\\\"padding\\\":\\\"15px 20px\\\",\\\"borderRadius\\\":\\\"8px\\\",\\\"border\\\":\\\"1px solid var(--border-color)\\\"},\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"style\\\":{\\\"fontSize\\\":\\\"1.1rem\\\",\\\"margin\\\":0,\\\"color\\\":\\\"var(--text-main)\\\"},\\\"children\\\":\\\"Q: CGSSB Recruitment Rules 2026 क्या है?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"style\\\":{\\\"margin\\\":\\\"10px 0 0 0\\\",\\\"color\\\":\\\"var(--text-muted)\\\"},\\\"children\\\":\\\"A: यह छत्तीसगढ़ शासन द्वारा विभिन्न तृतीय और चतुर्थ श्रेणी पदों के लिए निर्धारित न्यूनतम शैक्षणिक योग्यता और परीक्षा व्यवस्था से संबंधित अधिसूचना है।\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"background\\\":\\\"var(--card-bg)\\\",\\\"padding\\\":\\\"15px 20px\\\",\\\"borderRadius\\\":\\\"8px\\\",\\\"border\\\":\\\"1px solid var(--border-color)\\\"},\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"style\\\":{\\\"fontSize\\\":\\\"1.1rem\\\",\\\"margin\\\":0,\\\"color\\\":\\\"var(--text-main)\\\"},\\\"children\\\":\\\"Q: क्या यह कोई सीधी भर्ती notification है?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"style\\\":{\\\"margin\\\":\\\"10px 0 0 0\\\",\\\"color\\\":\\\"var(--text-muted)\\\"},\\\"children\\\":\\\"A: नहीं। इसे किसी एक भर्ती की vacancy notification नहीं समझना चाहिए। यह अलग-अलग पदों की eligibility और परीक्षा व्यवस्था से संबंधित नियम है।\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"background\\\":\\\"var(--card-bg)\\\",\\\"padding\\\":\\\"15px 20px\\\",\\\"borderRadius\\\":\\\"8px\\\",\\\"border\\\":\\\"1px solid var(--border-color)\\\"},\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"style\\\":{\\\"fontSize\\\":\\\"1.1rem\\\",\\\"margin\\\":0,\\\"color\\\":\\\"var(--text-main)\\\"},\\\"children\\\":\\\"Q: क्या 10वीं पास छात्र भी सरकारी नौकरी के लिए eligible हो सकते हैं?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"style\\\":{\\\"margin\\\":\\\"10px 0 0 0\\\",\\\"color\\\":\\\"var(--text-muted)\\\"},\\\"children\\\":\\\"A: हां। Group-7 में कई पदों के लिए 10वीं पास qualification निर्धारित है। वाहन चालक के लिए इसके अलावा driving licence जैसी शर्तें भी हैं।\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"background\\\":\\\"var(--card-bg)\\\",\\\"padding\\\":\\\"15px 20px\\\",\\\"borderRadius\\\":\\\"8px\\\",\\\"border\\\":\\\"1px solid var(--border-color)\\\"},\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"style\\\":{\\\"fontSize\\\":\\\"1.1rem\\\",\\\"margin\\\":0,\\\"color\\\":\\\"var(--text-main)\\\"},\\\"children\\\":\\\"Q: क्या 12वीं पास छात्रों के लिए भी पद हैं?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"style\\\":{\\\"margin\\\":\\\"10px 0 0 0\\\",\\\"color\\\":\\\"var(--text-muted)\\\"},\\\"children\\\":\\\"A: हां। Group-6 में कई पदों के लिए 10+2 qualification निर्धारित है।\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"background\\\":\\\"var(--card-bg)\\\",\\\"padding\\\":\\\"15px 20px\\\",\\\"borderRadius\\\":\\\"8px\\\",\\\"border\\\":\\\"1px solid var(--border-color)\\\"},\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"style\\\":{\\\"fontSize\\\":\\\"1.1rem\\\",\\\"margin\\\":0,\\\"color\\\":\\\"var(--text-main)\\\"},\\\"children\\\":\\\"Q: 27 जुलाई 2026 के संशोधन में क्या बदला?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"style\\\":{\\\"margin\\\":\\\"10px 0 0 0\\\",\\\"color\\\":\\\"var(--text-muted)\\\"},\\\"children\\\":\\\"A: मुख्य बदलावों में उप अभियंता (विद्युत/यांत्रिकी) का नया पद जोड़ना, सहायक पशु चिकित्सा क्षेत्र अधिकारी को Group-5 में जोड़ना 