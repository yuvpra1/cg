lor\\\":\\\"var(--color-primary)\\\",\\\"textDecoration\\\":\\\"none\\\"},\\\"className\\\":\\\"hover-underline\\\",\\\"children\\\":\\\"Yuvraj Pratap Rajwade\\\"}]]}],[\\\"$\\\",\\\"p\\\",null,{\\\"style\\\":{\\\"margin\\\":0,\\\"fontSize\\\":\\\"0.85rem\\\",\\\"color\\\":\\\"var(--text-muted)\\\"},\\\"children\\\":[\\\"Independent Web Developer and Publisher • Last Updated: \\\",\\\"16 August 2026\\\"]}]]}]]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"position\\\":\\\"relative\\\",\\\"width\\\":\\\"100%\\\",\\\"height\\\":\\\"auto\\\",\\\"marginBottom\\\":\\\"40px\\\",\\\"borderRadius\\\":\\\"12px\\\",\\\"overflow\\\":\\\"hidden\\\",\\\"boxShadow\\\":\\\"0 4px 10px rgba(0,0,0,0.1)\\\"},\\\"children\\\":[[\\\"$\\\",\\\"$L4\\\",null,{\\\"src\\\":\\\"/images/cg-current-affairs-may-june-2026.webp\\\",\\\"alt\\\":\\\"छत्तीसगढ़ करेंट अफेयर्स मई-जून 2026: हीरे की खोज, CM हेल्पलाइन, CBG नीति और महत्वपूर्ण घटनाएं\\\",\\\"width\\\":900,\\\"height\\\":500,\\\"style\\\":{\\\"width\\\":\\\"100%\\\",\\\"height\\\":\\\"auto\\\"},\\\"priority\\\":true}],[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"position\\\":\\\"absolute\\\",\\\"bottom\\\":\\\"10px\\\",\\\"right\\\":\\\"10px\\\",\\\"background\\\":\\\"rgba(0,0,0,0.65)\\\",\\\"color\\\":\\\"white\\\",\\\"padding\\\":\\\"5px 10px\\\",\\\"borderRadius\\\":\\\"4px\\\",\\\"fontSize\\\":\\\"0.8rem\\\",\\\"zIndex\\\":10},\\\"children\\\":\\\"This image is AI generated\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"content\\\",\\\"style\\\":{\\\"lineHeight\\\":\\\"1.8\\\",\\\"fontSize\\\":\\\"1.1rem\\\",\\\"color\\\":\\\"var(--text-main)\\\"},\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"छत्तीसगढ़ करेंट अफेयर्स 2026:\\\"}],\\\" मई और जून 2026 में छत्तीसगढ़ से जुड़ी कई महत्वपूर्ण घटनाएं सामने आईं। इनमें महासमुंद के बलौदा-बेलमुंडी डायमंड ब्लॉक में हीरों की खोज, रामगढ़ महोत्सव, भोरमदेव जंगल सफारी की शुरुआत, मुख्यमंत्री हेल्पलाइन 1076, छत्तीसगढ़ CBG नीति 2026 और NFHS-6 जैसे विषय प्रतियोगी परीक्षाओं की दृष्टि से महत्वपूर्ण हैं।\\\"]}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"$L5\\\",null,{\\\"href\\\":\\\"/jobs/cgssb-nssk26-recruitment-2026\\\",\\\"style\\\":{\\\"color\\\":\\\"var(--color-primary)\\\"},\\\"children\\\":\\\"CGPSC, CG Vyapam/CGSSB\\\"}],\\\", पुलिस भर्ती, शिक्षक भर्ती और अन्य राज्य स्तरीय प्रतियोगी परीक्षाओं की तैयारी करने वाले अभ्यर्थियों के लिए मई-जून 2026 के प्रमुख करेंट अफेयर्स यहां एक जगह दिए गए हैं।\\\"]}],[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"background\\\":\\\"var(--card-bg-hover)\\\",\\\"padding\\\":\\\"15px\\\",\\\"borderRadius\\\":\\\"8px\\\",\\\"border\\\":\\\"1px solid var(--border-color)\\\",\\\"margin\\\":\\\"20px 0\\\"},\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"नोट:\\\"}],\\\" नीचे केवल मई-जून 2026 की घटनाओं को प्राथमिकता दी गई है। बाद में सामने आई जुलाई 2026 की घटनाओं को इस सूची से अलग रखा गया है।\\\"]}],[\\\"$\\\",\\\"hr\\\",null,{\\\"style\\\":{\\\"margin\\\":\\\"40px 0\\\",\\\"borderColor\\\":\\\"var(--card-bg-hover)\\\"}}],[\\\"$\\\",\\\"h2\\\",null,{\\\"style\\\":{\\\"color\\\":\\\"var(--color-primary)\\\",\\\"fontSize\\\":\\\"1.8rem\\\",\\\"marginTop\\\":\\\"30px\\\",\\\"borderBottom\\\":\\\"2px solid var(--color-primary)\\\",\\\"paddingBottom\\\":\\\"10px\\\"},\\\"children\\\":\\\"1. महासमुंद में 1.22 कैरेट के पांच रफ हीरे मिले\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"जून 2026 में छत्तीसगढ़ के महासमुंद जिले के सरायपाली क्षेत्र स्थित बलौदा-बेलमुंडी डायमंड ब्लॉक से पांच रफ हीरे मिलने की खबर सामने आई। इन पांच हीरों का कुल वजन 1.22 कैरेट बताया गया है। इनमें दो हीरे जेम क्वालिटी के हैं, जबकि शेष हीरे गैर-रत्न श्रेणी के बताए गए हैं। NMDC-CMDC Limited के अनुसार ये हीरे 200 टन bulk sample material की जांच के दौरान प्राप्त हुए।\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"यह खोज इसलिए महत्वपूर्ण है क्योंकि इससे छत्तीसगढ़ में हीरा संसाधनों की संभावनाओं को लेकर नई रुचि पैदा हुई है। इसके बाद NMDC-CMDC Limited ने बलौदा-बेलमुंडी ब्लॉक में exploration के अगले चरण को आगे बढ़ाने की मंजूरी भी दी।\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"background\\\":\\\"var(--card-bg-hover)\\\",\\\"padding\\\":\\\"15px\\\",\\\"borderRadius\\\":\\\"8px\\\",\\\"border\\\":\\\"1px solid var(--border-color)\\\"},\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"परीक्षा के लिए याद रखें:\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"style\\\":{\\\"listStyleType\\\":\\\"disc\\\",\\\"paddingLeft\\\":\\\"20px\\\",\\\"marginTop\\\":\\\"10px\\\"},\\\"children\\\":[[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"जिला:\\\"}],\\\" महासमुंद\\\"]}],[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"क्षेत्र:\\\"}],\\\" सरायपाली\\\"]}],[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"ब्लॉक:\\\"}],\\\" बलौदा-बेलमुंडी डायमंड ब्लॉक\\\"]}],[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"कुल रफ हीरे:\\\"}],\\\" 5\\\"]}],[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"कुल वजन:\\\"}],\\\" 1.22 कैरेट\\\"]}],[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"जेम क्वालिटी:\\\"}],\\\" 2\\\"]}]]}]]}],[\\\"$\\\",\\\"h2\\\",null,{\\\"style\\\":{\\\"color\\\":\\\"var(--color-primary)\\\",\\\"fontSize\\\":\\\"1.8rem\\\",\\\"marginTop\\\":\\\"40px\\\",\\\"borderBottom\\\":\\\"2px solid var(--color-primary)\\\",\\\"paddingBottom\\\":\\\"10px\\\"},\\\"children\\\":\\\"2. मल्हार से महाशिवगुप्त बालार्जुन से संबंधित ताम्रपत्र\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"छत्तीसगढ़ के इतिहास और पुरातत्व की दृष्टि से महाशिवगुप्त बालार्जुन से संबंधित प्राचीन ताम्रपत्र भी महत्वपूर्ण विषय रहा। यह ताम्रपत्र बिलासपुर जिले के मल्हार क्षेत्र से संबंधित है और पांडुवंशीय शासक महाशिवगुप्त बालार्जुन से जोड़ा गया है।\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":[\\\"ताम्रपत्र में राजकीय आदेश और भूमि दान जैसी प्रशासनिक जानकारी का उल्लेख होने की बात सामने आई है। इसकी राजमुद्रा से जुड़े विवरण में \\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"त्रिशूल, कमंडल, नंदी और कमल\\\"}],\\\" जैसे प्रतीकों का उल्लेख किया गया है। यह विषय CGPSC की छत्तीसगढ़ इतिहास एवं संस्कृति की तैयारी के लिए विशेष रूप से उपयोगी है।\\\"]}],[\\\"$\\\",\\\"h2\\\",null,{\\\"style\\\":{\\\"color\\\":\\\"var(--color-primary)\\\",\\\"fontSize\\\":\\\"1.8rem\\\",\\\"marginTop\\\":\\\"40px\\\",\\\"borderBottom\\\":\\\"2px solid var(--color-primary)\\\",\\\"paddingBottom\\\":\\\"10px\\\"},\\\"children\\\":\\\"3. 'खूब तमाशा' और छत्तीसगढ़ साहित्य\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":[\\\"छत्तीसगढ़ की साहित्यिक एवं ऐतिहासिक विरासत से जुड़ा एक महत्वपूर्ण विषय 'खूब तमाशा' है। यह रचना \\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"गोपाल मिश्र\\\"}],\\\" से संबंधित है, जिन्हें रतनपुर के राजा राजसिंह के दरबारी कवि के रूप में बताया गया है। यह पांडुलिपि कोरबा जिले के शिवपुर क्षेत्र से संबंधित बताई गई है।\\\"]}],[\\\"$\\\",\\\"h2\\\",null,{\\\"style\\\":{\\\"color\\\":\\\"var(--color-primary)\\\",\\\"fontSize\\\":\\\"1.8rem\\\",\\\"marginTop\\\":\\\"40px\\\",\\\"borderBottom\\\":\\\"2px solid var(--color-primary)\\\",\\\"paddingBottom\\\":\\\"10px\\\"},\\\"children\\\":\\\"4. महासमुंद के बमनी में प्राचीन मंदिर के अवशेष\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"महासमुंद जिले के बमनी गांव से प्राचीन मंदिर के अवशेष और मूर्तियों की जानकारी सामने आई। इन अवशेषों को लगभग कलचुरी काल, 8वीं से 11वीं शताब्दी से संबंधित माना गया है।\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"बताए गए अवशेषों में मंदिर स्थापत्य से जुड़े पत्थर, आमलक तथा शिव, पार्वती, गणेश और कार्तिकेय से संबंधित प्रतिमाओं का उल्लेख मिलता है। यह क्षेत्र पंचकोशी यात्रा से भी जोड़ा गया है।\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Exam Point:\\\"}],\\\" बमनी गांव — महासमुंद जिला — प्राचीन मंदिर अवशेष एवं मूर्तियां।\\\"]}],[\\\"$\\\",\\\"h2\\\",null,{\\\"style\\\":{\\\"color\\\":\\\"var(--color-primary)\\\",\\\"fontSize\\\":\\\"1.8rem\\\",\\\"marginTop\\\":\\\"40px\\\",\\\"borderBottom\\\":\\\"2px solid var(--color-primary)\\\",\\\"paddingBottom\\\":\\\"10px\\\"},\\\"children\\\":\\\"5. रामगढ़ महोत्सव 2026\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":[\\\"सरगुजा जिले के ऐतिहासिक रामगढ़ में \\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"29 और 30 जून 2026\\\"}],\\\" को दो दिवसीय रामगढ़ महोत्सव आयोजित किया गया। यह आयोजन आषाढ़ के प्रथम दिवस के अवसर पर हुआ।\\\"]}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"रामगढ़ क्षेत्र अपनी ऐतिहासिक, सांस्कृतिक और साहित्यिक विरासत के लिए जाना जाता है। आयोजन में लोक संस्कृति, साहित्य, इतिहास, पुरातत्व और पर्यटन से जुड़े कार्यक्रम शामिल किए गए। रामगढ़ से संबंधित सीता बेंगरा, जोगीमारा और लक्ष्मण बेंगरा जैसी ऐतिहासिक गुफाएं भी महत्वपूर्ण हैं।\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"background\\\":\\\"var(--card-bg-hover)\\\",\\\"padding\\\":\\\"15px\\\",\\\"borderRadius\\\":\\\"8px\\\",\\\"border\\\":\\\"1px solid var(--border-color)\\\"},\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"परीक्षा में पूछा जा सकता है:\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"style\\\":{\\\"marginTop\\\":\\\"10px\\\"},\\\"children\\\":[[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"रामगढ़ महोत्सव का आयोजन कब होता है?\\\"}],\\\" → आषाढ़ माह के प्रथम दिवस के अवसर पर।\\\"]}],[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"रामगढ़ किस जिले में स्थित है?\\\"}],\\\" → सरगुजा।\\\"]}]]}]]}],[\\\"$\\\",\\\"h2\\\",null,{\\\"style\\\":{\\\"color\\\":\\\"var(--color-primary)\\\",\\\"fontSize\\\":\\\"1.8rem\\\",\\\"marginTop\\\":\\\"40px\\\",\\\"borderBottom\\\":\\\"2px solid var(--color-primary)\\\",\\\"paddingBottom\\\":\\\"10px\\\"},\\\"children\\\":\\\"6. भोरमदेव 