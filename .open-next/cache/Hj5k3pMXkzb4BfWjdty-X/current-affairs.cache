{"type":"app","meta":{"headers":{"x-next-cache-tags":"_N_T_/layout,_N_T_/current-affairs/layout,_N_T_/current-affairs/page,_N_T_/current-affairs"}},"html":"<!DOCTYPE html><html lang=\"hi\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\"/><link rel=\"stylesheet\" href=\"/_next/static/css/a082d47af8c37992.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-fe1bb94b21fde89c.js\"/><script src=\"/_next/static/chunks/fd9d1056-123aadff3a6f1f43.js\" async=\"\"></script><script src=\"/_next/static/chunks/5030-dfb188e0fb5d9176.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-9edc01f96f8414ff.js\" async=\"\"></script><script src=\"/_next/static/chunks/2972-f2e7899c8cf0f9e3.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/current-affairs/page-2b71ef567fc57dc3.js\" async=\"\"></script><script src=\"/_next/static/chunks/5878-ab61975c236bb910.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-4a8f5ea9fb7efe7b.js\" async=\"\"></script><title>Current Affairs | CGSSB Portal</title><meta name=\"description\" content=\"Latest Chhattisgarh Current Affairs for CGPSC, Vyapam, and other state exams.\"/><link rel=\"icon\" href=\"/icon.jpg\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body><header style=\"background-color:var(--bg-body);border-bottom:1px solid var(--border-color);position:sticky;top:0;z-index:100\"><div class=\"container\" style=\"display:flex;justify-content:space-between;align-items:center;height:70px\"><a style=\"display:flex;align-items:center;gap:10px;font-size:1.5rem;font-weight:700;color:var(--color-primary);letter-spacing:-0.5px\" href=\"/\"><img alt=\"CGSSB Logo\" loading=\"lazy\" width=\"36\" height=\"36\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent;border-radius:6px\" srcSet=\"/_next/image?url=%2Flogo.jpg&amp;w=48&amp;q=75 1x, /_next/image?url=%2Flogo.jpg&amp;w=96&amp;q=75 2x\" src=\"/_next/image?url=%2Flogo.jpg&amp;w=96&amp;q=75\"/>CGSSB</a><nav class=\"desktop-only\" style=\"gap:24px\"><a style=\"font-weight:500;color:var(--text-main)\" href=\"/jobs\">Jobs</a><a style=\"font-weight:500;color:var(--text-main)\" href=\"/current-affairs\">Current Affairs</a><a style=\"font-weight:500;color:var(--text-main)\" href=\"/cg-gk\">CG GK</a><a style=\"font-weight:500;color:var(--text-main)\" href=\"/tools\">Tools</a></nav><button class=\"mobile-only\" aria-label=\"Toggle menu\" style=\"background:none;border:none;flex-direction:column;justify-content:center;align-items:center;gap:5px;width:30px;height:30px;cursor:pointer\"><span style=\"display:block;width:25px;height:3px;background-color:var(--text-main);transition:all 0.3s;transform:none\"></span><span style=\"display:block;width:25px;height:3px;background-color:var(--text-main);opacity:1\"></span><span style=\"display:block;width:25px;height:3px;background-color:var(--text-main);transition:all 0.3s;transform:none\"></span></button></div></header><main style=\"min-height:calc(100vh - 70px - 150px)\"><div class=\"container\" style=\"padding-top:60px;padding-bottom:60px\"><header style=\"text-align:center;margin-bottom:50px\"><h1 style=\"font-size:2.5rem;margin-bottom:15px\">Current Affairs</h1><p style=\"font-size:1.2rem;color:var(--text-muted)\">Daily and Monthly Current Affairs updates for Chhattisgarh Competitive Exams.</p></header><div style=\"display:grid;gap:20px;max-width:800px;margin:0 auto\"><a style=\"text-decoration:none;color:inherit\" href=\"/current-affairs/general-dhiraj-seth-nepal-visit-2026\"><div class=\"card\" style=\"padding:25px;transition:transform 0.2s;cursor:pointer\"><h2 style=\"font-size:1.4rem;color:var(--color-primary);margin-bottom:10px\">General Dhiraj Seth Nepal Visit 2026: नेपाली सेना का मानद जनरल रैंक, महत्वपूर्ण तथ्य</h2><p style=\"color:var(--text-muted);margin-bottom:15px;line-height:1.5\">General Dhiraj Seth Nepal Visit 2026 की पूरी जानकारी। जानिए नेपाल यात्रा, Honorary General Rank, भारत-नेपाल सैन्य संबंध और परीक्षा के लिए महत्वपूर्ण facts।</p><span style=\"font-size:0.85rem;color:var(--text-muted);font-weight:bold\">Published on <!-- -->17 August 2026</span></div></a><a style=\"text-decoration:none;color:inherit\" href=\"/current-affairs/chhattisgarh-current-affairs-june-july-2026\"><div class=\"card\" style=\"padding:25px;transition:transform 0.2s;cursor:pointer\"><h2 style=\"font-size:1.4rem;color:var(--color-primary);margin-bottom:10px\">छत्तीसगढ़ करेंट अफेयर्स 2026: जून-जुलाई के महत्वपूर्ण प्रश्न और MCQ</h2><p style=\"color:var(--text-muted);margin-bottom:15px;line-height:1.5\">CGPSC, CGSSB (Vyapam), और छत्तीसगढ़ की अन्य सभी प्रतियोगी परीक्षाओं के लिए जून और जुलाई 2026 के महत्वपूर्ण करेंट अफेयर्स का संकलन, साथ ही MCQ और Quick Revision।</p><span style=\"font-size:0.85rem;color:var(--text-muted);font-weight:bold\">Published on <!-- -->17 August 2026</span></div></a><a style=\"text-decoration:none;color:inherit\" href=\"/current-affairs/cg-current-affairs-july-2026\"><div class=\"card\" style=\"padding:25px;transition:transform 0.2s;cursor:pointer\"><h2 style=\"font-size:1.4rem;color:var(--color-primary);margin-bottom:10px\">छत्तीसगढ़ करेंट अफेयर्स - जुलाई 2026 (CG Current Affairs)</h2><p style=\"color:var(--text-muted);margin-bottom:15px;line-height:1.5\">CGPSC, CGSSB (Vyapam), और छत्तीसगढ़ की अन्य सभी प्रतियोगी परीक्षाओं के लिए जुलाई 2026 के सबसे महत्वपूर्ण करंट अफेयर्स का संकलन।</p><span style=\"font-size:0.85rem;color:var(--text-muted);font-weight:bold\">Published on <!-- -->16 August 2026</span></div></a><a style=\"text-decoration:none;color:inherit\" href=\"/current-affairs/cg-current-affairs-may-june-2026\"><div class=\"card\" style=\"padding:25px;transition:transform 0.2s;cursor:pointer\"><h2 style=\"font-size:1.4rem;color:var(--color-primary);margin-bottom:10px\">छत्तीसगढ़ करेंट अफेयर्स - मई व जून 2026 (CG Current Affairs)</h2><p style=\"color:var(--text-muted);margin-bottom:15px;line-height:1.5\">CGPSC और CGSSB (Vyapam) के लिए मई-जून 2026 के महत्वपूर्ण करेंट अफेयर्स का सार, पुरातात्विक खोजें, योजनाएँ और खेल।</p><span style=\"font-size:0.85rem;color:var(--text-muted);font-weight:bold\">Published on <!-- -->16 August 2026</span></div></a></div></div></main><footer style=\"background-color:var(--bg-card);border-top:1px solid var(--border-color);padding:40px 0 20px;margin-top:60px\"><div class=\"container\" style=\"display:flex;flex-direction:column;align-items:center;text-align:center\"><h3 style=\"margin-bottom:10px\">Chhattisgarh Career &amp; Education Portal</h3><p style=\"max-width:600px;font-size:0.9rem\">One-stop destination for CGSSB, CGPSC, Vyapam notifications, syllabus, results, and study materials.</p><div style=\"max-width:800px;background-color:#fffbe8;border:1px solid #fde68a;padding:12px 16px;border-radius:6px;margin-top:20px;font-size:0.85rem;color:#92400e;text-align:left\"><strong>Disclaimer:</strong> CGSSB is an independent informational website and is not affiliated with or operated by the Government of Chhattisgarh, CGSSB, CG Vyapam, CGPSC, or any other government department or examination authority. For official information, please verify details from the relevant official website or notification.</div><div style=\"display:flex;flex-wrap:wrap;justify-content:center;gap:15px;margin-top:25px;padding-bottom:25px;border-bottom:1px solid var(--border-color);width:100%;max-width:800px\"><a style=\"font-size:0.85rem;color:var(--text-main)\" href=\"/about-us\">About Us</a><span style=\"color:var(--border-color)\">|</span><a style=\"font-size:0.85rem;color:var(--text-main)\" href=\"/author/yuvraj-pratap-rajwade\">Author</a><span style=\"color:var(--border-color)\">|</span><a style=\"font-size:0.85rem;color:var(--text-main)\" href=\"/editorial-policy\">Editorial Policy</a><span style=\"color:var(--border-color)\">|</span><a style=\"font-size:0.85rem;color:var(--text-main)\" href=\"/correction-policy\">Correction Policy</a><span style=\"color:var(--border-color)\">|</span><a style=\"font-size:0.85rem;color:var(--text-main)\" href=\"/contact-us\">Contact Us</a><span style=\"color:var(--border-color)\">|</span><a style=\"font-size:0.85rem;color:var(--text-main)\" href=\"/privacy-policy\">Privacy Policy</a><span style=\"color:var(--border-color)\">|</span><a style=\"font-size:0.85rem;color:var(--text-main)\" href=\"/terms\">Terms &amp; Conditions</a><span style=\"color:var(--border-color)\">|</span><a style=\"font-size:0.85rem;color:var(--text-main)\" href=\"/disclaimer\">Disclaimer</a></div><div style=\"margin-top:20px;font-size:0.85rem;color:var(--text-muted)\">© <!-- -->2026<!-- --> CGSSB Portal. Built for the students of Chhattisgarh. <br/>Email us at: <a href=\"mailto:contact@cgssb.com.in\" style=\"color:var(--color-primary)\">contact@cgssb.com.in</a></div></div></footer><script src=\"/_next/static/chunks/webpack-fe1bb94b21fde89c.js\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0]);self.__next_f.push([2,null])</script><script>self.__next_f.push([1,\"1:HL[\\\"/_next/static/css/a082d47af8c37992.css\\\",\\\"style\\\"]\\n\"])</script><script>self.__next_f.push([1,\"2:I[2846,[],\\\"\\\"]\\n4:I[2972,[\\\"2972\\\",\\\"static/chunks/2972-f2e7899c8cf0f9e3.js\\\",\\\"4014\\\",\\\"static/chunks/app/current-affairs/page-2b71ef567fc57dc3.js\\\"],\\\"\\\"]\\n5:I[4707,[],\\\"\\\"]\\n6:I[6423,[],\\\"\\\"]\\n7:I[5702,[\\\"5878\\\",\\\"static/chunks/5878-ab61975c236bb910.js\\\",\\\"2972\\\",\\\"static/chunks/2972-f2e7899c8cf0f9e3.js\\\",\\\"3185\\\",\\\"static/chunks/app/layout-4a8f5ea9fb7efe7b.js\\\"],\\\"default\\\"]\\n9:I[1060,[],\\\"\\\"]\\na:[]\\n\"])</script><script>self.__next_f.push([1,\"0:[\\\"$\\\",\\\"$L2\\\",null,{\\\"buildId\\\":\\\"Hj5k3pMXkzb4BfWjdty-X\\\",\\\"assetPrefix\\\":\\\"\\\",\\\"urlParts\\\":[\\\"\\\",\\\"current-affairs\\\"],\\\"initialTree\\\":[\\\"\\\",{\\\"children\\\":[\\\"current-affai