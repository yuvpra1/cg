srcSet=\"/_next/image?url=%2Flogo.jpg&amp;w=48&amp;q=75 1x, /_next/image?url=%2Flogo.jpg&amp;w=96&amp;q=75 2x\" src=\"/_next/image?url=%2Flogo.jpg&amp;w=96&amp;q=75\"/>CGSSB</a><nav class=\"desktop-only\" style=\"gap:24px\"><a style=\"font-weight:500;color:var(--text-main)\" href=\"/jobs\">Jobs</a><a style=\"font-weight:500;color:var(--text-main)\" href=\"/current-affairs\">Current Affairs</a><a style=\"font-weight:500;color:var(--text-main)\" href=\"/cg-gk\">CG GK</a><a style=\"font-weight:500;color:var(--text-main)\" href=\"/tools\">Tools</a></nav><button class=\"mobile-only\" aria-label=\"Toggle menu\" style=\"background:none;border:none;flex-direction:column;justify-content:center;align-items:center;gap:5px;width:30px;height:30px;cursor:pointer\"><span style=\"display:block;width:25px;height:3px;background-color:var(--text-main);transition:all 0.3s;transform:none\"></span><span style=\"display:block;width:25px;height:3px;background-color:var(--text-main);opacity:1\"></span><span style=\"display:block;width:25px;height:3px;background-color:var(--text-main);transition:all 0.3s;transform:none\"></span></button></div></header><main style=\"min-height:calc(100vh - 70px - 150px)\"><div class=\"container\" style=\"padding-top:40px;padding-bottom:60px\"><header style=\"text-align:center;margin-bottom:50px\"><h1 style=\"font-size:2.5rem;color:var(--color-primary);margin-bottom:15px\">Chhattisgarh GK (सामान्य ज्ञान)</h1><p style=\"font-size:1.1rem;color:var(--text-muted);max-width:700px;margin:0 auto\">CGPSC और CGSSB (Vyapam) परीक्षाओं के लिए छत्तीसगढ़ का सामान्य ज्ञान, इतिहास, संस्कृति और महान विभूतियों की जानकारी।</p></header><div class=\"responsive-grid\"><a style=\"text-decoration:none\" href=\"/cg-gk/buddhist-period-chhattisgarh\"><div class=\"card\" style=\"height:100%;display:flex;flex-direction:column\"><div style=\"font-size:0.85rem;color:var(--color-primary);font-weight:bold;margin-bottom:10px\">18 August 2026</div><h2 style=\"font-size:1.25rem;color:var(--text-main);margin-bottom:10px;line-height:1.4\">छत्तीसगढ़ का बौद्धकालीन इतिहास: सिरपुर, मैनपाट, भोंगापाल और महाजनपद काल</h2><p style=\"color:var(--text-muted);font-size:0.95rem;flex-grow:1\">छत्तीसगढ़ के बौद्धकालीन इतिहास, सिरपुर, मैनपाट, भोंगापाल, तुरतुरिया, मल्हार और महाजनपद काल की पूरी जानकारी आसान भाषा में पढ़ें।</p><div style=\"margin-top:15px;color:var(--color-primary);font-weight:600;font-size:0.9rem\">Read Article →</div></div></a><a style=\"text-decoration:none\" href=\"/cg-gk/chhattisgarh-prehistoric-period\"><div class=\"card\" style=\"height:100%;display:flex;flex-direction:column\"><div style=\"font-size:0.85rem;color:var(--color-primary);font-weight:bold;margin-bottom:10px\"></div><h2 style=\"font-size:1.25rem;color:var(--text-main);margin-bottom:10px;line-height:1.4\">छत्तीसगढ़ का प्राचीन इतिहास: प्रागैतिहासिक काल से महाभारत काल तक</h2><p style=\"color:var(--text-muted);font-size:0.95rem;flex-grow:1\">प्रागैतिहासिक काल, पाषाण काल, महापाषाण काल, वैदिक काल, रामायण काल और महाभारत काल के प्रमुख स्थल तथा ऐतिहासिक तथ्य। सिंघनपुर, कबरा पहाड़, चितवाडोंगरी।</p><div style=\"margin-top:15px;color:var(--color-primary);font-weight:600;font-size:0.9rem\">Read Article →</div></div></a><a style=\"text-decoration:none\" href=\"/cg-gk/teejan-bai-biography-pandavani\"><div class=\"card\" style=\"height:100%;display:flex;flex-direction:column\"><div style=\"font-size:0.85rem;color:var(--color-primary);font-weight:bold;margin-bottom:10px\">16 August 2026</div><h2 style=\"font-size:1.25rem;color:var(--text-main);margin-bottom:10px;line-height:1.4\">डॉ. तीजन बाई जीवन परिचय: पंडवानी, पुरस्कार, उपलब्धियां</h2><p style=\"color:var(--text-muted);font-size:0.95rem;flex-grow:1\">डॉ. तीजन बाई का जीवन परिचय पढ़ें। जानिए पंडवानी क्या है, कापालिक शैली, गुरु, Padma Shri, Padma Bhushan, Fukuoka Prize, Padma Vibhushan और उनके निधन से जुड़ी महत्वपूर्ण जानकारी।</p><div style=\"margin-top:15px;color:var(--color-primary);font-weight:600;font-size:0.9rem\">Read Article →</div></div></a></div></div></main><footer style=\"background-color:var(--bg-card);border-top:1px solid var(--border-color);padding:40px 0 20px;margin-top:60px\"><div class=\"container\" style=\"display:flex;flex-direction:column;align-items:center;text-align:center\"><h3 style=\"margin-bottom:10px\">Chhattisgarh Career &amp; Education Portal</h3><p style=\"max-width:600px;font-size:0.9rem\">One-stop destination for CGSSB, CGPSC, Vyapam notifications, syllabus, results, and study materials.</p><div style=\"max-width:800px;background-color:#fffbe8;border:1px solid #fde68a;padding:12px 16px;border-radius:6px;margin-top:20px;font-size:0.85rem;color:#92400e;text-align:left\"><strong>Disclaimer:</strong> CGSSB is an independent informational website and is not affiliated with or operated by the Government of Chhattisgarh, CGSSB, CG Vyapam, CGPSC, or any other government department or examination authority. For official information, please verify details from the relevant official website or notification.</div><div style=\"display:flex;flex-wrap:wrap;justify-content:center;gap:15px;margin-top:25px;padding-bottom:25px;border-bottom:1px solid var(--border-color);width:100%;max-width:800px\"><a style=\"font-size:0.85rem;color:var(--text-main)\" href=\"/about-us\">About Us</a><span style=\"color:var(--border-color)\">|</span><a style=\"font-size:0.85rem;color:var(--text-main)\" href=\"/author/yuvraj-pratap-rajwade\">Author</a><span style=\"color:var(--border-color)\">|</span><a style=\"font-size:0.85rem;color:var(--text-main)\" href=\"/editorial-policy\">Editorial Policy</a><span style=\"color:var(--border-color)\">|</span><a style=\"font-size:0.85rem;color:var(--text-main)\" href=\"/correction-policy\">Correction Policy</a><span style=\"color:var(--border-color)\">|</span><a style=\"font-size:0.85rem;color:var(--text-main)\" href=\"/contact-us\">Contact Us</a><span style=\"color:var(--border-color)\">|</span><a style=\"font-size:0.85rem;color:var(--text-main)\" href=\"/privacy-policy\">Privacy Policy</a><span style=\"color:var(--border-color)\">|</span><a style=\"font-size:0.85rem;color:var(--text-main)\" href=\"/terms\">Terms &amp; Conditions</a><span style=\"color:var(--border-color)\">|</span><a style=\"font-size:0.85rem;color:var(--text-main)\" href=\"/disclaimer\">Disclaimer</a></div><div style=\"margin-top:20px;font-size:0.85rem;color:var(--text-muted)\">© <!-- -->2026<!-- --> CGSSB Portal. Built for the students of Chhattisgarh. <br/>Email us at: <a href=\"mailto:contact@cgssb.com.in\" style=\"color:var(--color-primary)\">contact@cgssb.com.in</a></div></div></footer><script src=\"/_next/static/chunks/webpack-fe1bb94b21fde89c.js\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0]);self.__next_f.push([2,null])</script><script>self.__next_f.push([1,\"1:HL[\\\"/_next/static/css/a082d47af8c37992.css\\\",\\\"style\\\"]\\n\"])</script><script>self.__next_f.push([1,\"2:I[2846,[],\\\"\\\"]\\n4:I[2972,[\\\"2972\\\",\\\"static/chunks/2972-f2e7899c8cf0f9e3.js\\\",\\\"9122\\\",\\\"static/chunks/app/cg-gk/page-b07ea2ffd81e3d7d.js\\\"],\\\"\\\"]\\n5:I[4707,[],\\\"\\\"]\\n6:I[6423,[],\\\"\\\"]\\n7:I[5702,[\\\"5878\\\",\\\"static/chunks/5878-ab61975c236bb910.js\\\",\\\"2972\\\",\\\"static/chunks/2972-f2e7899c8cf0f9e3.js\\\",\\\"3185\\\",\\\"static/chunks/app/layout-4a8f5ea9fb7efe7b.js\\\"],\\\"default\\\"]\\n9:I[1060,[],\\\"\\\"]\\na:[]\\n\"])</script><script>self.__next_f.push([1,\"0:[\\\"$\\\",\\\"$L2\\\",null,{\\\"buildId\\\":\\\"Hj5k3pMXkzb4BfWjdty-X\\\",\\\"assetPrefix\\\":\\\"\\\",\\\"urlParts\\\":[\\\"\\\",\\\"cg-gk\\\"],\\\"initialTree\\\":[\\\"\\\",{\\\"children\\\":[\\\"cg-gk\\\",{\\\"children\\\":[\\\"__PAGE__\\\",{}]}]},\\\"$undefined\\\",\\\"$undefined\\\",true],\\\"initialSeedData\\\":[\\\"\\\",{\\\"children\\\":[\\\"cg-gk\\\",{\\\"children\\\":[\\\"__PAGE__\\\",{},[[\\\"$L3\\\",[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"container\\\",\\\"style\\\":{\\\"paddingTop\\\":\\\"40px\\\",\\\"paddingBottom\\\":\\\"60px\\\"},\\\"children