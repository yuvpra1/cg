{"type":"app","meta":{"headers":{"x-next-cache-tags":"_N_T_/layout,_N_T_/(tools)/layout,_N_T_/(tools)/tools/layout,_N_T_/(tools)/tools/photo-resizer/layout,_N_T_/(tools)/tools/photo-resizer/page,_N_T_/tools/photo-resizer"}},"html":"<!DOCTYPE html><html lang=\"hi\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\"/><link rel=\"stylesheet\" href=\"/_next/static/css/a082d47af8c37992.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-fe1bb94b21fde89c.js\"/><script src=\"/_next/static/chunks/fd9d1056-123aadff3a6f1f43.js\" async=\"\"></script><script src=\"/_next/static/chunks/5030-dfb188e0fb5d9176.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-9edc01f96f8414ff.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/(tools)/tools/photo-resizer/page-b04175d75c60ead2.js\" async=\"\"></script><script src=\"/_next/static/chunks/5878-ab61975c236bb910.js\" async=\"\"></script><script src=\"/_next/static/chunks/2972-f2e7899c8cf0f9e3.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-4a8f5ea9fb7efe7b.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/(tools)/tools/page-578f067a7ab87dcf.js\" async=\"\"></script><title>Photo &amp; Signature Resizer for Govt Exams (50KB) | CGSSB</title><meta name=\"description\" content=\"Easily resize and compress your passport size photo and signature under 50KB or 100KB for CGSSB, CGPSC, and Vyapam online application forms.\"/><link rel=\"icon\" href=\"/icon.jpg\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body><header style=\"background-color:var(--bg-body);border-bottom:1px solid var(--border-color);position:sticky;top:0;z-index:100\"><div class=\"container\" style=\"display:flex;justify-content:space-between;align-items:center;height:70px\"><a style=\"display:flex;align-items:center;gap:10px;font-size:1.5rem;font-weight:700;color:var(--color-primary);letter-spacing:-0.5px\" href=\"/\"><img alt=\"CGSSB Logo\" loading=\"lazy\" width=\"36\" height=\"36\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent;border-radius:6px\" srcSet=\"/_next/image?url=%2Flogo.jpg&amp;w=48&amp;q=75 1x, /_next/image?url=%2Flogo.jpg&amp;w=96&amp;q=75 2x\" src=\"/_next/image?url=%2Flogo.jpg&amp;w=96&amp;q=75\"/>CGSSB</a><nav class=\"desktop-only\" style=\"gap:24px\"><a style=\"font-weight:500;color:var(--text-main)\" href=\"/jobs\">Jobs</a><a style=\"font-weight:500;color:var(--text-main)\" href=\"/current-affairs\">Current Affairs</a><a style=\"font-weight:500;color:var(--text-main)\" href=\"/cg-gk\">CG GK</a><a style=\"font-weight:500;color:var(--text-main)\" href=\"/tools\">Tools</a></nav><button class=\"mobile-only\" aria-label=\"Toggle menu\" style=\"background:none;border:none;flex-direction:column;justify-content:center;align-items:center;gap:5px;width:30px;height:30px;cursor:pointer\"><span style=\"display:block;width:25px;height:3px;background-color:var(--text-main);transition:all 0.3s;transform:none\"></span><span style=\"display:block;width:25px;height:3px;background-color:var(--text-main);opacity:1\"></span><span style=\"display:block;width:25px;height:3px;background-color:var(--text-main);transition:all 0.3s;transform:none\"></span></button></div></header><main style=\"min-height:calc(100vh - 70px - 150px)\"><div class=\"container\" style=\"padding-top:60px;padding-bottom:60px\"><section style=\"text-align:center;margin-bottom:40px\"><h1 style=\"font-size:2.5rem;margin-bottom:15px\">Photo &amp; Signature Resizer</h1><p style=\"font-size:1.1rem;color:var(--text-muted);max-width:800px;margin:0 auto\">Stop struggling with Photoshop or heavy apps. Use this free browser tool to compress your photo and signature to meet the exact size requirements (e.g., 40KB - 60KB) of CGSSB (Vyapam) and CGPSC online forms. 100% secure, your image never leaves your device!</p></section><section><div class=\"card\" style=\"max-width:800px;margin:0 auto\"><div style=\"margin-bottom:25px;padding-bottom:20px;border-bottom:1px solid var(--border-color)\"><label style=\"display:block;font-weight:600;margin-bottom:10px\">Upload Photo or Signature (JPG/PNG)</label><input type=\"file\" accept=\"image/*\" style=\"width:100%;padding:10px;border:1px dashed var(--color-primary);border-radius:4px\"/></div><div style=\"display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:25px\"><div><label style=\"display:block;font-weight:600;margin-bottom:5px\">Target Width (px)</label><input type=\"number\" style=\"width:100%;padding:10px;border-radius:4px;border:1px solid var(--border-color)\" value=\"400\"/><small style=\"color:var(--text-muted)\">CGSSB forms usually prefer ~400px width.</small></div><div><label style=\"display:block;font-weight:600;margin-bottom:5px\">Compression Level</label><input type=\"range\" min=\"0.1\" max=\"1\" step=\"0.1\" style=\"width:100%;margin-top:10px\" value=\"0.8\"/><div style=\"display:flex;justify-content:space-between;font-size:0.8rem;color:var(--text-muted)\"><span>Low Size (Blurry)</span><span>High Size (Clear)</span></div></div></div><button disabled=\"\" style=\"width:100%;padding:12px;background-color:var(--text-muted);color:white;border:none;border-radius:4px;font-weight:600;cursor:not-allowed;margin-bottom:20px\">Resize &amp; Compress</button><canvas style=\"display:none\"></canvas></div></section><section style=\"margin-top:60px;max-width:800px;margin:60px auto 0\"><h2>How to compress image for CGSSB &amp; CGPSC forms?</h2><ul style=\"padding-left:20px;color:var(--text-muted);line-height:1.8\"><li><strong>Step 1:</strong> Click &quot;Choose File&quot; and upload your scanned passport photo or signature.</li><li><strong>Step 2:</strong> Adjust the Compression Level slider. Moving it to the left will reduce the KB size.</li><li><strong>Step 3:</strong> Click &quot;Resize &amp; Compress&quot;. The tool will instantly show you the new file size in KB.</li><li><strong>Step 4:</strong> If the size is within the required range (e.g., 40KB-60KB), click &quot;Download Resized Image&quot;. Otherwise, adjust the slider again.</li></ul></section></div></main><footer style=\"background-color:var(--bg-card);border-top:1px solid var(--border-color);padding:40px 0 20px;margin-top:60px\"><div class=\"container\" style=\"display:flex;flex-direction:column;align-items:center;text-align:center\"><h3 style=\"margin-bottom:10px\">Chhattisgarh Career &amp; Education Portal</h3><p style=\"max-width:600px;font-size:0.9rem\">One-stop destination for CGSSB, CGPSC, Vyapam notifications, syllabus, results, and study materials.</p><div style=\"max-width:800px;background-color:#fffbe8;border:1px solid #fde68a;padding:12px 16px;border-radius:6px;margin-top:20px;font-size:0.85rem;color:#92400e;text-align:left\"><strong>Disclaimer:</strong> CGSSB is an independent informational website and is not affiliated with or operated by the Government of Chhattisgarh, CGSSB, CG Vyapam, CGPSC, or any other government department or examination authority. For official information, please verify details from the relevant official website or notification.</div><div style=\"display:flex;flex-wrap:wrap;justify-content:center;gap:15px;margin-top:25px;padding-bottom:25px;border-bottom:1px solid var(--border-color);width:100%;max-width:800px\"><a style=\"font-size:0.85rem;color:var(--text-main)\" href=\"/about-us\">About Us</a><span style=\"color:var(--border-color)\">|</span><a style=\"font-size:0.85rem;color:var(--text-main)\" href=\"/author/yuvraj-pratap-rajwade\">Author</a><span style=\"color:var(--border-color)\">|</span><a style=\"font-size:0.85rem;color:var(--text-main)\" href=\"/editorial-policy\">Editorial Policy</a><span style=\"color:var(--border-color)\">|</span><a style=\"font-size:0.85rem;color:var(--text-main)\" href=\"/correction-policy\">Correction Policy</a><span style=\"color:var(--border-color)\">|</span><a style=\"font-size:0.85rem;color:var(--text-main)\" href=\"/contact-us\">Contact Us</a><span style=\"color:var(--border-color)\">|</span><a style=\"font-size:0.85rem;color:var(--text-main)\" href=\"/privacy-policy\">Privacy Policy</a><span style=\"color:var(--border-color)\">|</span><a style=\"font-size:0.85rem;color:var(--text-main)\" href=\"/terms\">Terms &amp; Conditions</a><span style=\"color:var(--border-color)\">|</span><a style=\"font-size:0.85rem;color:var(--text-main)\" href=\"/disclaimer\">Disclaimer</a></div><div style=\"margin-top:20px;font-size:0.85rem;color:var(--text-muted)\">© <!-- -->2026<!-- --> CGSSB Portal. Built for the students of Chhattisgarh. <br/>Email us at: <a href=\"mailto:contact@cgssb.com.in\" style=\"color:var(--color-primary)\">contact@cgssb.com.in</a></div></div></footer><script src=\"/_next/static/chunks/webpack-fe1bb94b21fde89c.js\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0]);self.__next_f.push([2,null])</script><script>self.__next_f.push([1,\"1:HL[\\\"/_next/static/css/a082d47af8c37992.css\\\",\\\"style\\\"]\\n\"])</script><script>self.__next_f.push([1,\"2:I[2846,[],\\\"\\\"]\\n4:I[4051,[\\\"6147\\\",\\\"static/chunks/app/(tools)/tools/photo-resizer/page-b04175d75c60ead2.js\\\"],\\\"default\\\"]\\n5:I[4707,[],\\\"\\\"]\\n6:I[6423,[],\\\"\\\"]\\n7:I[5702,[\\\"5878\\\",\\\"static/chunks/5878-ab61975c236bb910.js\\\",\\\"2972\\\",\\\"static/chunks/2972-f2e7899c8cf0f9e3.js\\\",\\\"3185\\\",\\\"static/chunks/app/layout-4a8f5ea9fb7efe7b.js\\\"],\\\"default\\\"]\\nc:I[2972,[\\\"2972\\\",\\\"static/chunks/2972-f2e7899c8cf0f9e3.js\\\",\\\"1078\\\",\\\"static/chunks/app/(tools)/tools/page-578f067a7ab87dcf.js\\\"],\\\"\\\"]\\ne:I[1060,[],\\\"\\\"]\\n8:{\\\"fontFamily\\\":\\\"system-ui,\\\\\\\"Segoe UI\\\\\\\",Roboto,Helvetica,Arial,sans-serif,\\\\\\\"Apple Color Emoji\\\\\\\",\\\\\\\"Segoe UI Emoji\\\\\\\"\\\",\\\"height\\\":\\\"100vh\\\",\\\"textAlign\\\":\\\"center\\\",\\\"display\