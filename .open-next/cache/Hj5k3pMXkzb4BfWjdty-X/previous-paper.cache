lid var(--border-color)\\\"},\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"fontWeight\\\":\\\"500\\\",\\\"color\\\":\\\"var(--text-main)\\\",\\\"marginBottom\\\":\\\"8px\\\"},\\\"children\\\":\\\"अपेक्स बैंक और जिला केंद्रीय सहकारी बैंक भर्ती परीक्षा (CBAS23) - 2023\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"display\\\":\\\"flex\\\",\\\"gap\\\":\\\"15px\\\",\\\"paddingLeft\\\":\\\"15px\\\",\\\"flexWrap\\\":\\\"wrap\\\"},\\\"children\\\":[[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://vyapam.cgstate.gov.in/sites/default/files/2023-10/57_203102-UJYR-SP-REC-M_A.pdf\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noopener noreferrer\\\",\\\"style\\\":{\\\"color\\\":\\\"var(--color-primary)\\\",\\\"textDecoration\\\":\\\"none\\\"},\\\"children\\\":\\\"📄 Main Document\\\"}],[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://vyapamcg.cgstate.gov.in/uploads/pdfs/fbda13b4-ada5-42ce-a45d-fb5ceaf3f682.pdf\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noopener noreferrer\\\",\\\"style\\\":{\\\"color\\\":\\\"var(--color-primary)\\\",\\\"textDecoration\\\":\\\"none\\\"},\\\"children\\\":\\\"📄 Morning Shift\\\"}],[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://vyapamcg.cgstate.gov.in/uploads/pdfs/83158817-5d14-4c91-838a-dd68513564e7.pdf\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noopener noreferrer\\\",\\\"style\\\":{\\\"color\\\":\\\"var(--color-primary)\\\",\\\"textDecoration\\\":\\\"none\\\"},\\\"children\\\":\\\"📄 Evening Shift\\\"}]]}]]}],[\\\"$\\\",\\\"li\\\",null,{\\\"style\\\":{\\\"padding\\\":\\\"15px 0\\\",\\\"borderBottom\\\":\\\"1px solid var(--border-color)\\\"},\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://vyapamcg.cgstate.gov.in/uploads/pdfs/717b3201-257c-4d49-b0ae-f575df0a1d07.pdf\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noopener noreferrer\\\",\\\"style\\\":{\\\"color\\\":\\\"var(--color-primary)\\\",\\\"fontWeight\\\":\\\"500\\\",\\\"textDecoration\\\":\\\"none\\\"},\\\"children\\\":\\\"📄 लोक स्वास्थ्य यांत्रिकी विभाग, नवा रायपुर के अंतर्गत हैण्डपंप तकनीशियन भर्ती परीक्षा 2023 (PHEH23)\\\"}]}],[\\\"$\\\",\\\"li\\\",null,{\\\"style\\\":{\\\"padding\\\":\\\"15px 0\\\",\\\"borderBottom\\\":\\\"1px solid var(--border-color)\\\"},\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"fontWeight\\\":\\\"500\\\",\\\"color\\\":\\\"var(--text-main)\\\",\\\"marginBottom\\\":\\\"8px\\\"},\\\"children\\\":\\\"संचालनालय महिला एवं बाल विकास विभाग, छत्तीसगढ़ के अंतर्गत पर्यवेक्षक (खुली सीधी भर्ती) एवं पर्यवेक्षक (परिसीमित सीधी भर्ती ) परीक्षा 2023\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"display\\\":\\\"flex\\\",\\\"gap\\\":\\\"15px\\\",\\\"paddingLeft\\\":\\\"15px\\\",\\\"flexWrap\\\":\\\"wrap\\\"},\\\"children\\\":[[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://vyapamcg.cgstate.gov.in/uploads/pdfs/b2f563fa-af17-42ff-a63f-9e7a7dce1eb9.pdf\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noopener noreferrer\\\",\\\"style\\\":{\\\"color\\\":\\\"var(--color-primary)\\\",\\\"textDecoration\\\":\\\"none\\\"},\\\"children\\\":\\\"📄 खुली सीधी भर्ती\\\"}],[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://vyapamcg.cgstate.gov.in/uploads/pdfs/13b47aa6-4520-465e-a63c-8a81eea79c6f.pdf\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noopener noreferrer\\\",\\\"style\\\":{\\\"color\\\":\\\"var(--color-primary)\\\",\\\"textDecoration\\\":\\\"none\\\"},\\\"children\\\":\\\"📄 परिसीमित सीधी भर्ती\\\"}]]}]]}],[\\\"$\\\",\\\"li\\\",null,{\\\"style\\\":{\\\"padding\\\":\\\"15px 0\\\",\\\"borderBottom\\\":\\\"1px solid var(--border-color)\\\"},\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://vyapamcg.cgstate.gov.in/uploads/pdfs/44d55548-0369-4fe2-8c42-7bb532deb82b.pdf\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noopener noreferrer\\\",\\\"style\\\":{\\\"color\\\":\\\"var(--color-primary)\\\",\\\"fontWeight\\\":\\\"500\\\",\\\"textDecoration\\\":\\\"none\\\"},\\\"children\\\":\\\"📄 संचालनालय रोजगार एवं प्रशिक्षण (प्र