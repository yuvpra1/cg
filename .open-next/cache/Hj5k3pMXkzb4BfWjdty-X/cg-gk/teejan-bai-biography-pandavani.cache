\":[[\\\"$\\\",\\\"span\\\",null,{\\\"style\\\":{\\\"background\\\":\\\"var(--color-primary)\\\",\\\"color\\\":\\\"white\\\",\\\"padding\\\":\\\"4px 12px\\\",\\\"borderRadius\\\":\\\"20px\\\",\\\"fontSize\\\":\\\"0.85rem\\\",\\\"fontWeight\\\":\\\"bold\\\"},\\\"children\\\":\\\"Chhattisgarh Culture\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"style\\\":{\\\"background\\\":\\\"var(--card-bg-hover)\\\",\\\"color\\\":\\\"var(--text-main)\\\",\\\"padding\\\":\\\"4px 12px\\\",\\\"borderRadius\\\":\\\"20px\\\",\\\"fontSize\\\":\\\"0.85rem\\\",\\\"fontWeight\\\":\\\"bold\\\"},\\\"children\\\":\\\"Biography\\\"}]]}],[\\\"$\\\",\\\"h1\\\",null,{\\\"style\\\":{\\\"fontSize\\\":\\\"2.5rem\\\",\\\"lineHeight\\\":\\\"1.2\\\",\\\"marginBottom\\\":\\\"20px\\\",\\\"color\\\":\\\"var(--text-main)\\\"},\\\"children\\\":\\\"डॉ. तीजन बाई: पंडवानी की विश्व प्रसिद्ध कलाकार, जीवन परिचय, पुरस्कार और उपलब्धियां\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"display\\\":\\\"flex\\\",\\\"flexWrap\\\":\\\"wrap\\\",\\\"alignItems\\\":\\\"center\\\",\\\"gap\\\":\\\"15px\\\",\\\"marginBottom\\\":\\\"25px\\\",\\\"padding\\\":\\\"15px\\\",\\\"background\\\":\\\"#f8fafc\\\",\\\"borderRadius\\\":\\\"10px\\\",\\\"border\\\":\\\"1px solid var(--border-color)\\\"},\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"width\\\":\\\"45px\\\",\\\"height\\\":\\\"45px\\\",\\\"borderRadius\\\":\\\"50%\\\",\\\"backgroundColor\\\":\\\"var(--color-primary)\\\",\\\"display\\\":\\\"flex\\\",\\\"alignItems\\\":\\\"center\\\",\\\"justifyContent\\\":\\\"center\\\",\\\"color\\\":\\\"white\\\",\\\"fontSize\\\":\\\"1.2rem\\\",\\\"fontWeight\\\":\\\"bold\\\"},\\\"children\\\":\\\"Y\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"style\\\":{\\\"margin\\\":0,\\\"fontSize\\\":\\\"0.95rem\\\",\\\"color\\\":\\\"var(--text-main)\\\",\\\"fontWeight\\\":\\\"600\\\"},\\\"children\\\":[\\\"Written \\u0026 Reviewed by \\\",[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"/author/yuvraj-pratap-rajwade\\\",\\\"style\\\":{\\\"color\\\":\\\"var(--color-primary)\\\",\\\"textDecoration\\\":\\\"none\\\"},\\\"className\\\":\\\"hover-underline\\\",\\\"children\\\":\\\"Yuvraj Pratap Rajwade\\\"}]]}],[\\\"$\\\",\\\"p\\\",null,{\\\"style\\\":{\\\"margin\\\":0,\\\"fontSize\\\":\\\"0.85rem\\\",\\\"color\\\":\\\"var(--text-muted)\\\"},\\\"children\\\":[\\\"Independent Web Developer and Publisher • Last Updated: \\\",\\\"16 August 2026\\\"]}]]}]]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"position\\\":\\\"relative\\\",\\\"width\\\":\\\"100%\\\",\\\"height\\\":\\\"auto\\\",\\\"marginBottom\\\":\\\"40px\\\",\\\"borderRadius\\\":\\\"12px\\\",\\\"overflow\\\":\\\"hidden\\\",\\\"boxShadow\\\":\\\"0 4px 10px rgba(0,0,0,0.1)\\\"},\\\"children\\\":[[\\\"$\\\",\\\"$L4\\\",null,{\\\"src\\\":\\\"/images/teejan-bai-biography-pandavani.webp\\\",\\\"alt\\\":\\\"डॉ. तीजन बाई: पंडवानी की विश्व प्रसिद्ध कलाकार, जीवन परिचय और उपलब्धियां\\\",\\\"width\\\":900,\\\"height\\\":500,\\\"style\\\":{\\\"width\\\":\\\"100%\\\",\\\"height\\\":\\\"auto\\\"},\\\"priority\\\":true}],[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"position\\\":\\\"absolute\\\",\\\"bottom\\\":\\\"10px\\\",\\\"right\\\":\\\"10px\\\",\\\"background\\\":\\\"rgba(0,0,0,0.65)\\\",\\\"color\\\":\\\"white\\\",\\\"padding\\\":\\\"5px 10px\\\",\\\"borderRadius\\\":\\\"4px\\\",\\\"fontSize\\\":\\\"0.8rem\\\",\\\"zIndex\\\":10},\\\"children\\\":\\\"This image is AI generated\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"content\\\",\\\"style\\\":{\\\"lineHeight\\\":\\\"1.8\\\",\\\"fontSize\\\":\\\"1.1rem\\\",\\\"color\\\":\\\"var(--text-main)\\\"},\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"छत्तीसगढ़ की लोक संस्कृति की बात हो और डॉ. तीजन बाई का नाम न आए, ऐसा संभव नहीं है। उन्होंने पंडवानी जैसी लोक कला को सिर्फ छत्तीसगढ़ तक सीमित नहीं रखा, बल्कि देश और विदेश के मंचों तक पहुंचाया।\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"महाभारत की कथाओं को अपनी दमदार आवाज, अभिनय और तंबूरे के साथ प्रस्तुत करने की उनकी शैली ने पंडवानी को एक अलग पहचान दी। खास बात यह रही कि जिस समय पंडवानी को मुख्य रूप से पुरुष कलाकारों की कला माना जाता था, उस समय तीजन बाई ने कापालिक शैली में मंच पर खड़े होकर प्रस्तुति दी और इस परंपरा को नई पहचान दिलाई।\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"5 जुलाई 2026 को उनके निधन के बाद छत्तीसगढ़ ने अपनी लोक संस्कृति की एक बड़ी कलाकार को खो दिया। Fukuoka Prize की आधिकारिक वेबसाइट ने भी उनके निधन की पुष्टि करते हुए उन्हें Pandavani की प्रमुख contemporary exponent बताया है।\\\"}],[\\\"$\\\",\\\"h2\\\",null,{\\\"style\\\":{\\\"color\\\":\\\"var(--color-primary)\\\",\\\"fontSize\\\":\\\"1.8rem\\\",\\\"marginTop\\\":\\\"40px\\\",\\\"borderBottom\\\":\\\"2px solid var(--color-primary)\\\",\\\"paddingBottom\\\":\\\"10px\\\"},\\\"children\\\":\\\"तीजन बाई कौन थीं?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"डॉ. तीजन बाई छत्तीसगढ़ की प्रसिद्ध पंडवानी गायिका और कलाकार थीं। पंडवानी महाभारत की कथाओं को लोक गायन और अभिनय के माध्यम से प्रस्तुत करने वाली पारंपरिक कला है।\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"Fukuoka Prize की आधिकारिक जानकारी के अनुसार तीजन बाई Pandavani की leading performing artist थीं और उन्होंने महाभारत की कथा को अपनी विशिष्ट प्रस्तुति के माध्यम से देश-विदेश में पहचान दिलाई।\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"उनकी खासियत केवल गायन नहीं थी। प्रस्तुति के दौरान वे अलग-अलग पात्रों के भाव, संवाद और घटनाओं को अपनी आवाज तथा शारीरिक अभिनय के माध्यम से जीवंत कर देती थीं।\\\"}],[\\\"$\\\",\\\"h2\\\",null,{\\\"style\\\":{\\\"color\\\":\\\"var(--color-primary)\\\",\\\"fontSize\\\":\\\"1.8rem\\\",\\\"marginTop\\\":\\\"40px\\\",\\\"borderBottom\\\":\\\"2px solid var(--color-primary)\\\",\\\"paddingBottom\\\":\\\"10px\\\"},\\\"children\\\":\\\"तीजन बाई का जन्म और प्रारंभिक जीवन\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"उपलब्ध स्रोतों के अनुसार तीजन बाई का जन्म दुर्ग जिले के भिलाई के पास गनियारी गांव (या कुछ स्रोतों के अनुसार पाटन के अटारी गांव में जन्म और गनियारी में पालन-पोषण) में हुआ था। उनके पिता का नाम चुनुकलाल और माता का नाम सुखवती था।\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"background\\\":\\\"var(--card-bg-hover)\\\",\\\"padding\\\":\\\"15px\\\",\\\"borderRadius\\\":\\\"8px\\\",\\\"border\\\":\\\"1px solid var(--border-color)\\\",\\\"margin\\\":\\\"20px 0\\\"},\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"महत्वपूर्ण तथ्य-जांच (Fact-Check) नोट:\\\"}],\\\" तीजन बाई की जन्मतिथि को लेकर उपलब्ध स्रोतों में अंतर मिलता है। Fukuoka Prize की official biography में \\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"8 अगस्त 1956\\\"}],\\\" दर्ज है, जबकि कुछ भारतीय शैक्षणिक/जीवनी स्रोत \\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"24 अप्रैल 1956\\\"}],\\\" बताते हैं।\\\"]}],[\\\"$\\\",\\\"h2\\\",null,{\\\"style\\\":{\\\"color\\\":\\\"var(--color-primary)\\\",\\\"fontSize\\\":\\\"1.8rem\\\",\\\"marginTop\\\":\\\"40px\\\",\\\"borderBottom\\\":\\\"2px solid var(--color-primary)\\\",\\\"paddingBottom\\\":\\\"10px\\\"},\\\"children\\\":\\\"पंडवानी क्या है?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"पंडवानी छत्तीसगढ़ की प्रसिद्ध लोक प्रदर्शन कला है, जिसमें महाभारत की कथाओं को गायन, संगीत और अभिनय के माध्यम से प्रस्तुत किया जाता है। 'पंडवानी' शब्द को सामान्य तौर पर पांडवों की वाणी/कथा से जोड़ा जाता है।\\\"}],[\\\"$\\\",\\\"h3\\\",null,{\\\"style\\\":{\\\"color\\\":\\\"var(--text-main)\\\",\\\"fontSize\\\":\\\"1.4rem\\\",\\\"marginTop\\\":\\\"20px\\\"},\\\"children\\\":\\\"पंडवानी की दो प्रमुख शैलियां\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"style\\\":{\\\"listStyleType\\\":\\\"disc\\\",\\\"paddingLeft\\\":\\\"20px\\\",\\\"marginBottom\\\":\\\"20px\\\"},\\\"children\\\":[[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"वेदमती शैली:\\\"}],\\\" इस शैली में कलाकार सामान्यतः बैठकर पंडवानी की प्रस्तुति करता है। गायन और चेहरे के भावों के माध्यम से कथा को आगे बढ़ाया जाता है।\\\"]}],[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"कापालिक शैली:\\\"}],\\\" कापालिक शैली में कलाकार खड़े होकर और अधिक गतिशील अभिनय के साथ कथा प्रस्तुत करता है।\\\"]}]]}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":[\\\"तीजन बाई की सबसे बड़ी पहचान इसी \\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"कापालिक शैली\\\"}],\\\" से बनी। उन्होंने 13 वर्ष की उम्र में सार्वजनिक प्रस्तुति दी और कापालिक शैली में प्रदर्शन करने वाली महिला कलाकार के रूप में एक महत्वपूर्ण बदलाव पैदा किया।\\\"]}],[\\\"$\\\",\\\"h2\\\",null,{\\\"style\\\":{\\\"color\\\":\\\"var(--color-primary)\\\",\\\"fontSize\\\":\\\"1.8rem\\\",\\\"marginTop\\\":\\\"40px\\\",\\\"borderBottom\\\":\\\"2px solid var(--color-primary)\\\",\\\"paddingBottom\\\":\\\"10px\\\"},\\\"children\\\":\\\"तीजन बाई के गुरु कौन थे?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":[\\\"तीजन बाई ने पंडवानी का प्रारंभिक ज्ञान अपने \\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"नाना बृजलाल\\\"}],\\\" से प्राप्त किया था। बाद में उन्होंने \\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"उमेद सिंह देशमुख\\\"}],\\\" से प्रशिक्षण लिया।\\\"]}],[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"background\\\":\\\"var(--card-bg-hover)\\\",\\\"padding\\\":\\\"15px\\\",\\\"borderRadius\\\":\\\"8px\\\",\\\"border\\\":\\\"1px solid var(--border-color)\\\"},\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"परीक्षा के लिए याद रखें:\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"style\\\":{\\\"listStyleType\\\":\\\"disc\\\",\\\"paddingLeft\\\":\\\"20px\\\",\\\"marginTop\\\":\\\"10px\\\"},\\\"children\\\":[[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"प्रारंभिक गुरु:\\\"}],\\\" नाना बृजलाल\\\"]}],[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"बाद में प्रशिक्षण:\\\"}],\\\" उमेद सिंह देशमुख\\\"]}]]}]]}],[\\\"$\\\",\\\"h2\\\",null,{\\\"style\\\":{\\\"color\\\":\\\"var(--color-primary)\\\",\\\"fontSize\\\":\\\"1.8rem\\\"