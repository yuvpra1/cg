tr\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"td\\\",null,{\\\"style\\\":{\\\"padding\\\":\\\"8px\\\",\\\"borderBottom\\\":\\\"1px solid var(--border-color)\\\"},\\\"children\\\":\\\"2-8\\\"}],[\\\"$\\\",\\\"td\\\",null,{\\\"style\\\":{\\\"padding\\\":\\\"8px\\\",\\\"borderBottom\\\":\\\"1px solid var(--border-color)\\\"},\\\"children\\\":\\\"कालीपुर, खड़गघाट, गढ़चंदेला, घाटलोहांगा, भातेवाड़ा, राजपुर, गढ़ घोघरा\\\"}],[\\\"$\\\",\\\"td\\\",null,{\\\"style\\\":{\\\"padding\\\":\\\"8px\\\",\\\"borderBottom\\\":\\\"1px solid var(--border-color)\\\"},\\\"children\\\":\\\"बस्तर\\\"}]]}],[\\\"$\\\",\\\"tr\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"td\\\",null,{\\\"style\\\":{\\\"padding\\\":\\\"8px\\\",\\\"borderBottom\\\":\\\"1px solid var(--border-color)\\\"},\\\"children\\\":\\\"9\\\"}],[\\\"$\\\",\\\"td\\\",null,{\\\"style\\\":{\\\"padding\\\":\\\"8px\\\",\\\"borderBottom\\\":\\\"1px solid var(--border-color)\\\"},\\\"children\\\":\\\"जयमरगा\\\"}],[\\\"$\\\",\\\"td\\\",null,{\\\"style\\\":{\\\"padding\\\":\\\"8px\\\",\\\"borderBottom\\\":\\\"1px solid var(--border-color)\\\"},\\\"children\\\":\\\"जशपुर\\\"}]]}],[\\\"$\\\",\\\"tr\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"td\\\",null,{\\\"style\\\":{\\\"padding\\\":\\\"8px\\\",\\\"borderBottom\\\":\\\"1px solid var(--border-color)\\\"},\\\"children\\\":\\\"10\\\"}],[\\\"$\\\",\\\"td\\\",null,{\\\"style\\\":{\\\"padding\\\":\\\"8px\\\",\\\"borderBottom\\\":\\\"1px solid var(--border-color)\\\"},\\\"children\\\":\\\"केराझर\\\"}],[\\\"$\\\",\\\"td\\\",null,{\\\"style\\\":{\\\"padding\\\":\\\"8px\\\",\\\"borderBottom\\\":\\\"1px solid var(--border-color)\\\"},\\\"children\\\":\\\"रायगढ़\\\"}]]}]]}]]}]]}],[\\\"$\\\",\\\"h4\\\",null,{\\\"style\\\":{\\\"marginTop\\\":\\\"20px\\\",\\\"color\\\":\\\"var(--text-main)\\\"},\\\"children\\\":\\\"कबरा पहाड़\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"कबरा पहाड़ रायगढ़ का एक महत्वपूर्ण प्रागैतिहासिक स्थल है। यहां लाल रंग के शैलचित्रों के प्रमाण मिलते हैं। शैलचित्रों में विभिन्न पशु आकृतियों तथा मानव समूहों का चित्रण मिलता है। यहां से पाषाणकालीन औजारों के प्रमाण भी जुड़े हैं।\\\"}],[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"article-section-title\\\",\\\"style\\\":{\\\"marginTop\\\":\\\"40px\\\",\\\"marginBottom\\\":\\\"20px\\\",\\\"fontSize\\\":\\\"1.8rem\\\",\\\"color\\\":\\\"var(--color-primary)\\\"},\\\"children\\\":\\\"3. उत्तर पाषाण काल\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":[\\\"उत्तर पाषाण काल से संबंधित प्रमाणों में छोटे पाषाण उपकरणों और शैलचित्रों का महत्व है। इससे संबंधित प्रमुख स्थल के रूप में \\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"धनपुर\\\"}],\\\" का उल्लेख मिलता है।\\\"]}],[\\\"$\\\",\\\"ul\\\",null,{\\\"style\\\":{\\\"margin\\\":\\\"10px 0 20px 30px\\\"},\\\"children\\\":[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"धनपुर (गौरेला-पेंड्रा-मरवाही):\\\"}],\\\" यहां मानव आकृतियों से संबंधित शैलचित्रों का उल्लेख मिलता है।\\\"]}]}],[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"article-section-title\\\",\\\"style\\\":{\\\"marginTop\\\":\\\"40px\\\",\\\"marginBottom\\\":\\\"20px\\\",\\\"fontSize\\\":\\\"1.8rem\\\",\\\"color\\\":\\\"var(--color-primary)\\\"},\\\"children\\\":\\\"4. नव पाषाण काल\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":[\\\"नव पाषाण काल तक मानव जीवन में महत्वपूर्ण बदलाव दिखाई देने लगे थे। इस चरण में मानव के जीवन में स्थायित्व, कृषि, पशुपालन और अन्य गतिविधियों का विकास हुआ। छत्तीसगढ़ के संदर्भ में \\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"चितवाडोंगरी\\\"}],\\\" एक महत्वपूर्ण स्थल है।\\\"]}],[\\\"$\\\",\\\"ul\\\",null,{\\\"style\\\":{\\\"margin\\\":\\\"10px 0 20px 30px\\\"},\\\"children\\\":[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"चितवाडोंगरी (बालोद):\\\"}],\\\" यहां की गुफाओं में अनेक शैलचित्रों का प्रमाण मिला है।\\\"]}]}],[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"article-section-title\\\",\\\"style\\\":{\\\"marginTop\\\":\\\"40px\\\",\\\"marginBottom\\\":\\\"20px\\\",\\\"fontSize\\\":\\\"1.8rem\\\",\\\"color\\\":\\\"var(--color-primary)\\\"},\\\"children\\\":\\\"5. छत्तीसगढ़ के अन्य प्रमुख प्रागैतिहासिक स्थल\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"छत्तीसगढ़ के अलग-अलग क्षेत्रों में कई अन्य शैलाश्रय और शैलचित्र स्थल भी मिलते हैं। इनमें प्रमुख नाम हैं: खैरपुर, सूतीपाट/भंवरखोल, करमागढ़, चारामा, बसनाझार, ओंगना, सिरौली-डोंगरी, छोटे पंडरमुड़ा, गाड़ागौरी, उड़कुड़ा और खैरखेड़ा। इनमें कई स्थलों से पशु, मानव, शिकार, कृषि तथा अन्य गतिविधियों से संबंधित शैलचित्रों का उल्लेख मिलता है।\\\"}],[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"article-section-title\\\",\\\"style\\\":{\\\"marginTop\\\":\\\"40px\\\",\\\"marginBottom\\\":\\\"20px\\\",\\\"fontSize\\\":\\\"1.8rem\\\",\\\"color\\\":\\\"var(--color-primary)\\\"},\\\"children\\\":\\\"6. महापाषाण काल (Megalithic Age)\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"महापाषाण या Megalithic संस्कृति में बड़े पत्थरों से बनाए गए स्मारक और अन्य संरचनाएं महत्वपूर्ण मानी जाती हैं। छत्तीसगढ़ में महापाषाणकालीन अवशेष कई क्षेत्रों से जुड़े हैं।\\\"}],[\\\"$\\\",\\\"table\\\",null,{\\\"style\\\":{\\\"width\\\":\\\"100%\\\",\\\"borderCollapse\\\":\\\"collapse\\\",\\\"marginBottom\\\":\\\"20px\\\",\\\"marginTop\\\":\\\"15px\\\"},\\\"children\\\":[[\\\"$\\\",\\\"thead\\\",null,{\\\"children\\\":[\\\"$\\\",\\\"tr\\\",null,{\\\"style\\\":{\\\"background\\\":\\\"var(--color-primary)\\\",\\\"color\\\":\\\"white\\\",\\\"textAlign\\\":\\\"left\\\"},\\\"children\\\":[[\\\"$\\\",\\\"th\\\",null,{\\\"style\\\":{\\\"padding\\\":\\\"12px\\\",\\\"border\\\":\\\"1px solid var(--border-color)\\\"},\\\"children\\\":\\\"महापाषाण कालीन स्थल\\\"}],[\\\"$\\\",\\\"th\\\",null,{\\\"style\\\":{\\\"padding\\\":\\\"12px\\\",\\\"border\\\":\\\"1px solid var(--border-color)\\\"},\\\"children\\\":\\\"जिला\\\"}]]}]}],[\\\"$\\\",\\\"tbody\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"tr\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"td\\\",null,{\\\"style\\\":{\\\"padding\\\":\\\"12px\\