ans\\\":\\\"B. बालोद\\\"},{\\\"q\\\":\\\"6. वैदिक काल की सामान्य अवधि क्या मानी जाती है?\\\",\\\"opts\\\":[\\\"A. 2500–1500 ई.पू.\\\",\\\"B. 1500–600 ई.पू.\\\",\\\"C. 1000–500 ई.पू.\\\",\\\"D. 600–200 ई.पू.\\\"],\\\"ans\\\":\\\"B. 1500–600 ई.पू.\\\"},{\\\"q\\\":\\\"7. नर्मदा नदी का वैदिक साहित्य में किस नाम से उल्लेख मिलता है?\\\",\\\"opts\\\":[\\\"A. गोदावरी\\\",\\\"B. रेवा\\\",\\\"C. चित्रोत्पला\\\",\\\"D. महानदी\\\"],\\\"ans\\\":\\\"B. रेवा\\\"},{\\\"q\\\":\\\"8. तुरतुरिया का संबंध किस ऋषि से जोड़ा जाता है?\\\",\\\"opts\\\":[\\\"A. अगस्त्य\\\",\\\"B. वाल्मीकि\\\",\\\"C. विश्वामित्र\\\",\\\"D. वशिष्ठ\\\"],\\\"ans\\\":\\\"B. वाल्मीकि\\\"},{\\\"q\\\":\\\"9. सिहावा क्षेत्र का संबंध किन ऋषियों की परंपराओं से मिलता है?\\\",\\\"opts\\\":[\\\"A. केवल अगस्त्य\\\",\\\"B. केवल विश्वामित्र\\\",\\\"C. अनेक ऋषियों की परंपराओं से\\\",\\\"D. केवल वाल्मीकि\\\"],\\\"ans\\\":\\\"C. अनेक ऋषियों की परंपराओं से\\\"},{\\\"q\\\":\\\"10. सिरपुर का प्राचीन नाम क्या बताया गया है?\\\",\\\"opts\\\":[\\\"A. भाण्डेर\\\",\\\"B. चित्रांगदपुर\\\",\\\"C. खल्लवाटिका\\\",\\\"D. मणिपुर\\\"],\\\"ans\\\":\\\"B. चित्रांगदपुर\\\"},{\\\"q\\\":\\\"11. खल्लारी का प्राचीन नाम क्या बताया गया है?\\\",\\\"opts\\\":[\\\"A. चित्रांगदपुर\\\",\\\"B. भाण्डेर\\\",\\\"C. खल्लवाटिका\\\",\\\"D. कोसल\\\"],\\\"ans\\\":\\\"C. खल्लवाटिका\\\"},{\\\"q\\\":\\\"12. महाभारतकालीन परंपरा में रतनपुर का संबंध किस प्राचीन नाम से जोड़ा गया है?\\\",\\\"opts\\\":[\\\"A. मणिपुर/रत्नावलीपुरी\\\",\\\"B. चित्रांगदपुर\\\",\\\"C. खल्लवाटिका\\\",\\\"D. दंडकारण्य\\\"],\\\"ans\\\":\\\"A. मणिपुर/रत्नावलीपुरी\\\"}],\\\"title\\\":\\\"विद्यार्थियों के लिए महत्वपूर्ण MCQ\\\"}],[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"article-section-title\\\",\\\"style\\\":{\\\"marginTop\\\":\\\"40px\\\",\\\"marginBottom\\\":\\\"20px\\\",\\\"fontSize\\\":\\\"1.8rem\\\",\\\"color\\\":\\\"var(--color-primary)\\\"},\\\"children\\\":\\\"निष्कर्ष\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"छत्तीसगढ़ का प्राचीन इतिहास कई परतों में फैला हुआ है। सिंघनपुर और कबरा पहाड़ के शैलचित्रों से लेकर महापाषाणकालीन अवशेषों तक, फिर वैदिक साहित्य में मिलने वाले भौगोलिक संकेतों और रामायण तथा महाभारत से जुड़ी स्थानीय परंपराओं तक, यह क्षेत्र इतिहास और पुरातत्व की दृष्टि से काफी महत्वपूर्ण है।\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":[\\\"विद्यार्थियों को इस पूरे विषय को केवल तारीखों के रूप में याद करने के बजाय \\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"“काल → प्रमुख स्थल → जिला → विशेषता”\\\"}],\\\" के क्रम में पढ़ना चाहिए। इससे CGPSC, CG Vyapam, CGSSB और अन्य प्रतियोगी परीक्षाओं में आने वाले तथ्यात्मक प्रश्नों को याद रखना आसान होगा।\\\"]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"marginTop\\\":\\\"40px\\\",\\\"padding\\\":\\\"25px\\\",\\\"background\\\":\\\"#f8fafc\\\",\\\"borderRadius\\\":\\\"12px\\\",\\\"border\\\":\\\"1px solid var(--border-color)\\\"},\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"style\\\":{\\\"fontSize\\\":\\\"1.2rem\\\",\\\"marginBottom\\\":\\\"15px\\\",\\\"color\\\":\\\"var(--text-main)\\\"},\\\"children\\\":\\\"📋 Article Information\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"style\\\":{\\\"listStyle\\\":\\\"none\\\",\\\"padding\\\":0,\\\"margin\\\":0,\\\"fontSize\\\":\\\"0.95rem\\\",\\\"color\\\":\\\"var(--text-muted)\\\",\\\"display\\\":\\\"flex\\\",\\\"flexDirection\\\":\\\"column\\\",\\\"gap\\\":\\\"10px\\\"},\\\"children\\\":[[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Written \\u0026 Reviewed by:\\\"}],\\\" \\\",[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"/author/yuvraj-pratap-rajwade\\\",\\\"style\\\":{\\\"color\\\":\\\"var(--color-primary)\\\",\\\"textDecoration\\\":\\\"none\\\"},\\\"children\\\":\\\"Yuvraj Pratap Rajwade\\\"}]]}],[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Last Updated:\\\"}],\\\" \\\",\\\"August 17, 2026\\\"]}],[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Source:\\\"}],\\\" \\\",\\\"Archaeological Survey of India, Mahabharata, Ramayana \\u0026 State Cultural Department Records\\\"]}],[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Correction:\\\"}],\\\" जानकारी में कोई गलती मिले? \\\",[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"mailto:contact@cgssb.com.in\\\",\\\"style\\\":{\\\"color\\\":\\\"#d97706\\\",\\\"textDecoration\\\":\\\"none\\\",\\\"fontWeight\\\":\\\"600\\\"},\\\"children\\\":\\\"[Report a Correction]\\\"}]]}]]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"marginTop\\\":\\\"40px\\\",\\\"padding\\\":\\\"20px\\\",\\\"backgroundColor\\\":\\\"var(--card-bg-hover)\\\",\\\"border\\\":\\\"1px solid var(--border-color)\\\",\\\"borderRadius\\\":\\\"8px\\\",\\\"fontSize\\\":\\\"0.9rem\\\",\\\"color\\\":\\\"#ef4444\\\"},\\\"children\\\":[[\\\"$\\\",\\\"h4\\\",null,{\\\"style\\\":{\\\"margin\\\":\\\"0 0 10px 0\\\",\\\"color\\\":\\\"#ef4444\\\"},\\\"children\\\":\\\"महत्वपूर्ण सूचना / Disclaimer\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"style\\\":{\\\"margin\\\":0,\\\"color\\\":\\\"var(--text-main)\\\"},\\\"children\\\":[\\\"अस्वीकरण: इस लेख में दी गई जानकारी विद्यार्थियों की प्रतियोगी परीक्षा की तैयारी और सामान्य शैक्षणिक जानकारी के उद्देश्य से प्रकाशित की गई है। अलग-अलग पुस्तकों, स्थानीय परंपराओं या अन्य स्रोतों में किसी स्थान के नाम, वर्तनी अथवा ऐतिहासिक व्याख्या में अंतर हो सकता है। इसलिए परीक्षा के लिए अंतिम रूप से संबंधित आधिकारिक पाठ्यक्रम, परीक्षा बोर्ड की अधिसूचना और मान्य संदर्भ सामग्री से तथ्यों का मिलान जरूर करें। \\\",[\\\"$\\\",\\\"br\\\",null,{}],[\\\"$\\\",\\\"br\\\",null,{}],\\\"यदि इस लेख में आपको कोई तथ्यात्मक त्रुटि दिखाई देती है, तो कृपया \\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"CGSSB.com.in\\\"}],\\\" के Contact माध्यम से हमें बताएं, ताकि आवश्यक सुधार किया जा सके।\\\"]}]]}]]}]}],null],null],null]},[null,[\\\"$\\\",\\\"$L6\\\",null,{\\\"parallelRouterKey\\\":\\\"children\\\",\\\"segmentPath\\\":[\\\"children\\\",\\\"cg-gk\\\",\\\"children\\\",\\\"chhattisgarh-pre