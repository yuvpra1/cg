\\",null,{\\\"children\\\":\\\"स्टेशन ऑफिसर, फायर मैन, स्टोर कीपर, वाहन चालक, वाचरूम ऑपरेटर\\\"}],\\\" और अन्य पदों सहित कुल \\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"295 रिक्तियों\\\"}],\\\" पर भर्ती की जाएगी।\\\"]}],[\\\"$\\\",\\\"p\\\",null,{\\\"style\\\":{\\\"marginBottom\\\":\\\"15px\\\"},\\\"children\\\":[\\\"CGSSB द्वारा जारी परीक्षा निर्देश के अनुसार इस भर्ती की लिखित परीक्षा \\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"22 नवंबर 2026\\\"}],\\\" को आयोजित की जाएगी। परीक्षा के लिए आवेदन प्रक्रिया 11 अगस्त 2026 से शुरू हुई है और उम्मीदवार 7 सितंबर 2026 शाम 5 बजे तक online application कर सकते हैं।\\\"]}],[\\\"$\\\",\\\"p\\\",null,{\\\"style\\\":{\\\"marginBottom\\\":\\\"30px\\\"},\\\"children\\\":\\\"अगर आप इस भर्ती में आवेदन करने की तैयारी कर रहे हैं, तो नीचे हमने परीक्षा की date, application process, fee और exam day instructions को आसान भाषा में समझाया है।\\\"}],[\\\"$\\\",\\\"h2\\\",null,{\\\"style\\\":{\\\"fontSize\\\":\\\"1.9rem\\\",\\\"marginBottom\\\":\\\"15px\\\",\\\"color\\\":\\\"var(--color-primary)\\\",\\\"border\\\":\\\"1px solid var(--border-color)\\\",\\\"paddingBottom\\\":\\\"8px\\\"},\\\"children\\\":\\\"CGSSB NSSK26 क्या है?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"style\\\":{\\\"marginBottom\\\":\\\"15px\\\"},\\\"children\\\":\\\"NSSK26 नगर सेना, अग्निशमन एवं आपातकालीन सेवाएँ तथा SDRF के अंतर्गत विभिन्न पदों की लिखित भर्ती परीक्षा का examination code है।\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"style\\\":{\\\"marginBottom\\\":\\\"30px\\\"},\\\"children\\\":\\\"यह परीक्षा छत्तीसगढ़ कर्मचारी चयन मंडल (CGSSB) द्वारा आयोजित की जा रही है। परीक्षा निर्देश में CGSSB की website के साथ पुराने CG Vyapam portal का भी उल्लेख किया गया है।\\\"}],[\\\"$\\\",\\\"h2\\\",null,{\\\"style\\\":{\\\"fontSize\\\":\\\"1.9rem\\\",\\\"marginBottom\\\":\\\"15px\\\",\\\"color\\\":\\\"var(--color-primary)\\\",\\\"border\\\":\\\"1px solid var(--border-color)\\\",\\\"paddingBottom\\\":\\\"8px\\\"},\\\"children\\\":\\\"CGSSB NSSK26 Important Dates\\\"}],[