primary);letter-spacing:-0.5px\" href=\"/\"><img alt=\"CGSSB Logo\" loading=\"lazy\" width=\"36\" height=\"36\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent;border-radius:6px\" srcSet=\"/_next/image?url=%2Flogo.jpg&amp;w=48&amp;q=75 1x, /_next/image?url=%2Flogo.jpg&amp;w=96&amp;q=75 2x\" src=\"/_next/image?url=%2Flogo.jpg&amp;w=96&amp;q=75\"/>CGSSB</a><nav class=\"desktop-only\" style=\"gap:24px;align-items:center\"><a style=\"font-weight:500;color:var(--text-main)\" href=\"/jobs\">Jobs</a><a style=\"font-weight:500;color:var(--text-main)\" href=\"/current-affairs\">Current Affairs</a><a style=\"font-weight:500;color:var(--text-main)\" href=\"/cg-gk\">CG GK</a><a style=\"font-weight:500;color:var(--text-main)\" href=\"/tools\">Tools</a></nav><button class=\"mobile-only\" aria-label=\"Toggle menu\" style=\"background:none;border:none;flex-direction:column;justify-content:center;align-items:center;gap:5px;width:30px;height:30px;cursor:pointer\"><span style=\"display:block;width:25px;height:3px;background-color:var(--text-main);transition:all 0.3s;transform:none\"></span><span style=\"display:block;width:25px;height:3px;background-color:var(--text-main);opacity:1\"></span><span style=\"display:block;width:25px;height:3px;background-color:var(--text-main);transition:all 0.3s;transform:none\"></span></button></div></header><main style=\"min-height:calc(100vh - 70px - 150px)\"><div class=\"container\" style=\"padding-top:30px;padding-bottom:0\"><nav aria-label=\"breadcrumb\"><ol style=\"display:flex;flex-wrap:wrap;list-style:none;padding:12px 16px;margin:0;font-size:0.9rem;background-color:var(--card-bg-hover);border-radius:8px;border:1px solid var(--border-color);color:var(--text-muted)\"><li style=\"display:flex;align-items:center\"><a style=\"color:var(--color-primary);text-decoration:none;font-weight:500\" href=\"/\">🏠 Home</a></li><li style=\"display:flex;align-items:center\"><span style=\"margin:0 10px;color:var(--border-color)\">❯</span><span style=\"color:var(--text-main);font-weight:600\" aria-current=\"page\">Tools</span></li></ol></nav></div><div class=\"container\" style=\"padding-top:60px;padding-bottom:60px\"><h1 style=\"font-size:2.5rem;margin-bottom:15px;text-align:center\">Student Tools</h1><p style=\"font-size:1.1rem;color:var(--text-muted);max-width:700px;margin:0 auto 50px;text-align:center\">Free utilities designed specifically to help CGSSB and CGPSC aspirants in their application and preparation journey.</p><div class=\"responsive-grid\" style=\"margin-bottom:60px\"><a class=\"card\" style=\"display:block\" href=\"/tools/age-calculator\"><h2 style=\"font-size:1.5rem;color:var(--color-primary);margin-bottom:10px\">Exam Age Calculator</h2><p style=\"margin:0\">Calculate your exact age in years, months, and days for exam forms.</p></a><a class=\"card\" style=\"display:block\" href=\"/tools/percentage-calculator\"><h2 style=\"font-size:1.5rem;color:var(--color-primary);margin-bottom:10px\">Percentage Calculator</h2><p style=\"margin:0\">Instantly calculate your 10th/12th/Degree percentage.</p></a><a class=\"card\" style=\"display:block\" href=\"/tools/typing-test\"><h2 style=\"font-size:1.5rem;color:var(--color-primary);margin-bottom:10px\">Typing Speed Test</h2><p style=\"margin:0\">Practice Hindi/English typing for Assistant Grade 3 &amp; DEO exams.</p></a><a class=\"card\" style=\"display:block\" href=\"/tools/photo-resizer\"><h2 style=\"font-size:1.5rem;color:var(--color-primary);margin-bottom:10px\">Photo &amp; Signature Resizer</h2><p style=\"margin:0\">Compress your passport photo &amp; signature to 50KB for Vyapam forms.</p></a><a class=\"card\" style=\"display:block\" href=\"/tools/image-to-pdf\"><h2 style=\"font-size:1.5rem;color:var(--color-primary);margin-bottom:10px\">Image to PDF Converter</h2><p style=\"margin:0\">Convert your marksheet photos directly to PDF safely in your browser.</p></a></div></div></main><footer style=\"background-color:var(--bg-card);border-top:1px solid var(--b