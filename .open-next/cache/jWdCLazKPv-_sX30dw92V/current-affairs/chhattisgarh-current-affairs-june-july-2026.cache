सकें।\"]}],[\"$\",\"h2\",null,{\"className\":\"article-section-title\",\"style\":{\"marginTop\":\"40px\",\"marginBottom\":\"20px\",\"fontSize\":\"1.8rem\",\"color\":\"var(--color-primary)\"},\"children\":\"जून-जुलाई 2026 के महत्वपूर्ण छत्तीसगढ़ करेंट अफेयर्स\"}],[\"$\",\"h3\",null,{\"style\":{\"marginTop\":\"30px\",\"color\":\"var(--color-primary)\"},\"children\":\"1. खेत बचाओ अभियान 2026\"}],[\"$\",\"p\",null,{\"children\":\"छत्तीसगढ़ में खेत बचाओ अभियान 2026 की शुरुआत 1 जून 2026 से की गई। इस अभियान में मृदा स्वास्थ्य को बनाए रखने और किसानों को संतुलित उर्वरक उपयोग के प्रति जागरूक करने पर जोर दिया गया।\"}],[\"$\",\"p\",null,{\"children\":\"किसानों के लिए मिट्टी की गुणवत्ता बनाए रखना जरूरी है, क्योंकि लंबे समय तक असंतुलित उर्वरक इस्तेमाल करने से मिट्टी की उर्वरता प्रभावित हो सकती है।\"}],[\"$\",\"div\",null,{\"style\":{\"background\":\"var(--card-bg-hover)\",\"padding\":\"15px\",\"borderRadius\":\"8px\",\"borderLeft\":\"4px solid var(--color-primary)\",\"margin\":\"15px 0\"},\"children\":[[\"$\",\"strong\",null,{\"children\":\"याद रखने योग्य तथ्य:\"}],[\"$\",\"ul\",null,{\"style\":{\"margin\":\"5px 0 0 20px\"},\"children\":[[\"$\",\"li\",null,{\"children\":\"अभियान — खेत बचाओ अभियान 2026\"}],[\"$\",\"li\",null,{\"children\":\"शुरुआत — 1 जून 2026\"}],[\"$\",\"li\",null,{\"children\":\"मुख्य विषय — मृदा स्वास्थ्य और संतुलित उर्वरक उपयोग\"}]]}]]}],[\"$\",\"h3\",null,{\"style\":{\"marginTop\":\"30px\",\"color\":\"var(--color-primary)\"},\"children\":\"2. प्रधानमंत्री मातृ वंदना योजना में छत्तीसगढ़ का प्रदर्शन\"}],[\"$\",\"p\",null,{\"children\":\"प्रधानमंत्री मातृ वंदना योजना से जुड़े विशेष अभियान में छत्तीसगढ़ के प्रदर्शन को महत्वपूर्ण उपलब्धि के रूप में बताया गया है।\"}],[\"$\",\"p\",null,{\"children\":\"इस अभियान में छत्तीसगढ़ को देश में पहला स्थान मिलने की जानकारी दी गई है। वहीं जांजगीर-चांपा जिले को 96 प्रतिशत लक्ष्य पूर्ति के साथ प्रदेश में पहला स्थान मिलने का उल्लेख किया गया है।\"}],[\"$\",\"p\",null,{\"children\":\"यह योजना मातृत्व के दौरान महिलाओं को आर्थिक सहा