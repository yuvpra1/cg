(--border-color)\\\"},\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"width\\\":\\\"45px\\\",\\\"height\\\":\\\"45px\\\",\\\"borderRadius\\\":\\\"50%\\\",\\\"backgroundColor\\\":\\\"var(--color-primary)\\\",\\\"display\\\":\\\"flex\\\",\\\"alignItems\\\":\\\"center\\\",\\\"justifyContent\\\":\\\"center\\\",\\\"color\\\":\\\"white\\\",\\\"fontSize\\\":\\\"1.2rem\\\",\\\"fontWeight\\\":\\\"bold\\\"},\\\"children\\\":\\\"Y\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"style\\\":{\\\"margin\\\":0,\\\"fontSize\\\":\\\"0.95rem\\\",\\\"color\\\":\\\"var(--text-main)\\\",\\\"fontWeight\\\":\\\"600\\\"},\\\"children\\\":[\\\"Written \\u0026 Reviewed by \\\",[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"/author/yuvraj-pratap-rajwade\\\",\\\"style\\\":{\\\"color\\\":\\\"var(--color-primary)\\\",\\\"textDecoration\\\":\\\"none\\\"},\\\"className\\\":\\\"hover-underline\\\",\\\"children\\\":\\\"Yuvraj Pratap Rajwade\\\"}]]}],[\\\"$\\\",\\\"p\\\",null,{\\\"style\\\":{\\\"margin\\\":0,\\\"fontSize\\\":\\\"0.85rem\\\",\\\"color\\\":\\\"var(--text-muted)\\\"},\\\"children\\\":[\\\"Independent Web Developer and Publisher • Last Updated: \\\",\\\"August 19, 2026\\\"]}]]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"position\\\":\\\"relative\\\",\\\"width\\\":\\\"100%\\\",\\\"height\\\":\\\"auto\\\",\\\"marginBottom\\\":\\\"40px\\\",\\\"borderRadius\\\":\\\"12px\\\",\\\"overflow\\\":\\\"hidden\\\",\\\"boxShadow\\\":\\\"0 4px 10px rgba(0,0,0,0.3)\\\"},\\\"children\\\":[[\\\"$\\\",\\\"$L4\\\",null,{\\\"src\\\":\\\"/images/nep-2020-education-policy-india.webp\\\",\\\"alt\\\":\\\"राष्ट्रीय शिक्षा नीति 2020 (NEP 2020)\\\",\\\"width\\\":900,\\\"height\\\":500,\\\"style\\\":{\\\"width\\\":\\\"100%\\\",\\\"height\\\":\\\"auto\\\"},\\\"priority\\\":true}],[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"position\\\":\\\"absolute\\\",\\\"bottom\\\":\\\"10px\\\",\\\"right\\\":\\\"10px\\\",\\\"background\\\":\\\"rgba(0,0,0,0.65)\\\",\\\"color\\\":\\\"white\\\",\\\"padding\\\":\\\"5px 10px\\\",\\\"borderRadius\\\":\\\"4px\\\",\\\"fontSize\\\":\\\"0.8rem\\\",\\\"zIndex\\\":10},\\\"children\\\":\\\"NEP 2020\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"article-content\\\",\\\"style\\\":{\\\"lineHeight\\\":\\\"1.8\\\",\\\"fontSize\\\":\\\"1.1rem\\\",\\\"color\\\":\\\"var(--text-main)\\\"},\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"राष्ट्रीय शिक्षा नीति 2020 (NEP 2020) भारत की शिक्षा व्यवस्था में एक महत्वपूर्ण बदलाव लेकर आई। यह स्वतंत्र भारत की तीसरी राष्ट्रीय शिक्षा नीति है। इससे पहले 1968 और 1986 में राष्ट्रीय शिक्षा नीतियां लागू की गई थीं। 1986 की नीति में 1992 में संशोधन किया गया था।\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"NEP 2020 का उद्देश्य भारत की शिक्षा व्यवस्था को अधिक गुणवत्तापूर्ण, समावेशी, लचीला और वैश्विक स्तर के अनुरूप बनाना है। नीति को केंद्रीय मंत्रिमंडल ने 29 जुलाई 2020 को मंजूरी दी थी। इसके मसौदे से जुड़ी समिति की अध्यक्षता डॉ. के. कस्तूरीरंगन ने की थी।\\\"}],[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"article-section-title\\\",\\\"style\\\":{\\\"marginTop\\\":\\\"40px\\\",\\\"marginBottom\\\":\\\"20px\\\",\\\"fontSize\\\":\\\"1.8rem\\\",\\\"color\\\":\\\"var(--color-primary)\\\"},\\\"children\\\":\\\"NEP 2020 का इतिहास\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"भारत में अब तक तीन राष्ट्रीय शिक्षा नीतियां आई हैं:\\\"}],[\\\"$\\\",\\\"table\\\",null,{\\\"style\\\":{\\\"width\\\":\\\"100%\\\",\\\"borderCollapse\\\":\\\"collapse\\\",\\\"marginBottom\\\":\\\"20px\\\",\\\"marginTop\\\":\\\"15px\\\"},\\\"children\\\":[[\\\"$\\\",\\\"thead\\\",null,{\\\"children\\\":[\\\"$\\\",\\\"tr\\\",null,{\\\"style\\\":{\\\"background\\\":\\\"var(--color-primary)\\\",\\\"color\\\":\\\"white\\\",\\\"textAlign\\\":\\\"left\\\"},\\\"children\\\":[[\\\"$\\\",\\\"th\\\",null,{\\\"style\\\":{\\\"padding\\\":\\\"12px\\\",\\\"border\\\":\\\"1px solid var(--border-color)\\\"},\\\"children\\\":\\\"राष्ट्रीय शिक्षा नीति\\\"}],[\\\"$\\\",\\\"th\\\",null,{\\\"style\\\":{\\\"padding\\\":\\\"12px\\\",\\\"border\\\":\\\"1px solid var(--border-color)\\\"},\\\"children\\\":\\\"वर्ष\\\"}],[\\\"$\\\",\\\"th\\\",null,{\\\"style\\\":{\\\"padding\\\":\\\"12px\\\",\\\"border\\\":\\\"1px solid var(--border-color)\\\"},\\\"children\\\":\\\"प्रमुख जानकारी\\\"}]]}]}],[\\\"$\\\",\\\"tbody\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"tr\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"td\\\",null,{\\\"style\\\":{\\\"padding\\\":\\\"12px\\\",\\\"border\\\":\\\"1px solid var(--border-color)\\\"},\\\"children\\\":\\\"पहली NEP\\\"}],[\\\"$\\\",\\\"td\\\",null,{\\\"style\\\":{\\\"padding\\\":\\\"12px\\\",\\\"border\\\":\\\"1px solid var(--border-color)\\\",\\\"fontWeight\\\":\\\"bold\\\"},\\\"children\\\":\\\"1968\\\"}],[\\\"$\\\",\\\"td\\\",null,{\\\"style\\\":{\\\"padding\\\":\\\"12px\\\",\\\"border\\\":\\\"1px solid var(--border-color)\\\"},\\\"children\\\":\\\"कोठारी आयोग की सिफारिशों पर आधारित\\\"}]]}],[\\\"$\\\",\\\"tr\\\",null,{\\\"style\\\":{\\\"background\\\":\\\"var(--card-bg-hover)\\\"},\\\"children\\\":[[\\\"$\\\",\\\"td\\\",null,{\\\"style\\\":{\\\"padding\\\":\\\"12px\\\",\\\"border\\\":\\\"1px solid var(--border-color)\\\"},\\\"children\\\":\\\"दूसरी NEP\\\"}],[\\\"$\\\",\\\"td\\\",null,{\\\"style\\\":{\\\"padding\\\":\\\"12px\\\",\\\"border\\\":\\\"1px solid var(--border-color)\\\",\\\"fontWeight\\\":\\\"bold\\\"},\\\"children\\\":\\\"1986\\\"}],[\\\"$\\\",\\\"td\\\",null,{\\\"style\\\":{\\\"padding\\\":\\\"12px\\\",\\\"border\\\":\\\"1px solid var(--border-color)\\\"},\\\"children\\\":\\\"1992 में संशोधन/POA\\\"}]]}],[\\\"$\\\",\\\"tr\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"td\\\",null,{\\\"style\\\":{\\\"padding\\\":\\\"12px\\\",\\\"border\\\":\\\"1px solid var(--border-color)\\\"},\\\"children\\\":\\\"तीसरी NEP\\\"}],[\\\"$\\\",\\\"td\\\",null,{\\\"style\\\":{\\\"padding\\\":\\\"12px\\\",\\\"border\\\":\\\"1px solid var(--border-color)\\\",\\\"fontWeight\\\":\\\"bold\\\"},\\\"children\\\":\\\"2020\\\"}],[\\\"$\\\",\\\"